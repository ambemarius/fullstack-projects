# Copy to config/.env and supply local values. Never commit real secrets.

# ---- Required ----
DB_STRING=Server=YOUR_SERVER;Database=YOUR_DATABASE;User Id=YOUR_USER;Password=YOUR_PASSWORD;Encrypt=true;TrustServerCertificate=false;
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ---- Runtime ----
# production enables Secure cookies; use it on any real school server.
NODE_ENV=development
PORT=2026
# Public URL users type in the browser, e.g. https://lms.lycee-batouri.cm
# Used for cross-site request checks on cookie sessions. Leave empty to match the Host header.
PUBLIC_ORIGIN=
# Set to true only when running behind a reverse proxy (nginx, IIS ARR) that sets X-Forwarded-For.
TRUST_PROXY=false
# Lifetime of sign-in tokens (jsonwebtoken format: 1h, 8h, 30m).
JWT_EXPIRES_IN=1h
# Where uploaded student photos and staff documents are stored (outside public/). Default: ./uploads
UPLOAD_DIR=
# Base URL of the canonical school workspace, if one is deployed. Leave empty to hide its links.
WORKSPACE_BASE_URL=
# Set LOGIN_RATE_LIMIT=on to enforce login throttling while NODE_ENV=test.
LOGIN_RATE_LIMIT=

# ---- First-admin seeding (npm run seed) ----
# Required only for explicitly authorised first-admin seeding.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Used once on a fresh database to create the school record (ignored if one exists).
SCHOOL_CODE=
SCHOOL_NAME=
# Anglophone, Francophone or Bilingual (default Bilingual)
SCHOOL_SYSTEM=

# ---- Isolated SQL test database (npm run test:sql) ----
# See docs/implementation/TEST_DATABASE_SETUP.md. Lives in config/.env.test.local, not here.
# LMS_TEST_DB_ACK=synthetic-only
# LMS_TEST_DB_SERVER=
# LMS_TEST_DB_ALLOWED_SERVER=
# LMS_TEST_DB_NAME=lms_test_local
# LMS_TEST_DB_ALLOWED_NAME=lms_test_local
# LMS_TEST_DB_USER=
# LMS_TEST_DB_PASSWORD=
# LMS_TEST_DB_TRUST_CERTIFICATE=false
