# Copy to config/.env and supply local values. Never commit real secrets.
DB_STRING=Server=YOUR_SERVER;Database=YOUR_DATABASE;User Id=YOUR_USER;Password=YOUR_PASSWORD;Encrypt=true;TrustServerCertificate=false;
PORT=2026
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Required only for explicitly authorised first-admin seeding.
ADMIN_EMAIL=
ADMIN_PASSWORD=
