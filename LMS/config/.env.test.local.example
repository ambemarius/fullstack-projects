# Copy to config/.env.test.local only after the DBA provisions the synthetic database.
# This file is not loaded by normal application startup.
NODE_ENV=test
LMS_TEST_DB_ACK=synthetic-only
LMS_TEST_DB_SERVER=YOUR_SERVER\YOUR_INSTANCE
LMS_TEST_DB_ALLOWED_SERVER=YOUR_SERVER\YOUR_INSTANCE
LMS_TEST_DB_NAME=lms_test_codex
LMS_TEST_DB_ALLOWED_NAME=lms_test_codex
LMS_TEST_DB_USER=lms_test_codex_user
LMS_TEST_DB_PASSWORD=SET_LOCALLY_DO_NOT_COMMIT
LMS_TEST_DB_TRUST_CERTIFICATE=false
# Confirm this path with the DBA for the test instance.
LMS_TEST_BACKUP_DIRECTORY=B:\Default
