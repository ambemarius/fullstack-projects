<%- include('partials/header', { title: 'Login' }) %>

<div class="lms-login-layout">
  <section class="lms-login-intro">
    <p class="lms-eyebrow">LYCEE BATOURI</p>
    <h1>Welcome to your school workspace</h1>
    <p>Sign in with your school account to access your dashboard, records and tools.</p>
  </section>

  <section class="card auth-card">
    <h2>Sign in</h2>
    <p style="color:var(--muted);font-size:14px;margin:0 0 4px">Choose your role and enter your credentials.</p>
    <form id="loginForm">
      <label>Account type
        <select id="role">
          <option value="admin">Administrator</option>
          <option value="teacher">Teacher</option>
          <option value="student">Pupil</option>
          <option value="parent">Parent / Guardian</option>
        </select>
      </label>
      <label id="identLabel">Email
        <input id="identifier" required autocomplete="username" placeholder="Enter your email" />
      </label>
      <label>Password
        <input type="password" id="password" required autocomplete="current-password" placeholder="Enter your password" />
      </label>
      <button type="submit" class="btn" id="loginBtn" style="width:100%">Sign in</button>
    </form>
    <p id="msg" class="msg" role="status" aria-live="polite"></p>
    <p style="text-align:center;color:var(--muted);font-size:13px;margin-top:16px">Forgotten your password? Contact your school administrator.</p>
  </section>
</div>

<script src="/js/toast.js"></script>
<script src="/js/auth.js"></script>
<%- include('partials/footer') %>
