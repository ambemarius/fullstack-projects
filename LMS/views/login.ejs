<%- include('partials/header', { title: 'Login', hideSchoolName: true }) %>

<div class="lms-login-layout">
  <section class="lms-login-intro">
    <p class="lms-eyebrow">KodoSchool</p>
    <h1>Welcome to your school workspace</h1>
    <p>Sign in with your school account to access your dashboard, records and tools.</p>
  </section>

  <section class="card auth-card">
    <h2>Sign in</h2>
    <p style="color:var(--muted);font-size:14px;margin:0 0 4px">Choose your role and enter your credentials.</p>
    <form id="loginForm">
      <label>Account type
        <select id="role">
          <option value="teacher" selected>Teacher</option>
          <option value="student">Student</option>
          <option value="parent">Parent / Guardian</option>
          <option value="auxiliary">Non-teaching staff</option>
          <option value="admin">Administrator</option>
        </select>
      </label>
      <div class="school-pick" id="schoolCodeField">
        <label for="schoolSearch">Your school</label>
        <div class="school-combo">
          <input id="schoolSearch" type="text" role="combobox" aria-autocomplete="list" aria-expanded="false" aria-controls="schoolList"
                 aria-describedby="schoolCodeHint" autocomplete="off" spellcheck="false" maxlength="80" placeholder="Choose or type your school's name" />
          <button type="button" class="school-combo-toggle" id="schoolToggle" aria-label="Show all schools" tabindex="-1">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </button>
          <ul id="schoolList" class="school-list" role="listbox" aria-label="Schools" hidden></ul>
        </div>
        <input type="hidden" id="schoolCode" />
        <small id="schoolCodeHint" class="field-hint">Remembered on this device.</small>
      </div>
      <label id="identLabel">Email
        <input id="identifier" required autocomplete="username" placeholder="Enter your email" />
      </label>
      <label>Password
        <input type="password" id="password" required autocomplete="current-password" placeholder="Enter your password" data-reveal />
      </label>
      <button type="submit" class="btn" id="loginBtn" style="width:100%">Sign in</button>
    </form>
    <p id="msg" class="msg" role="status" aria-live="polite"></p>
    <p style="text-align:center;color:var(--muted);font-size:13px;margin-top:16px">Forgotten your password? Contact your school administrator.</p>
  </section>
</div>

<script src="/js/toast.js"></script>
<script src="/js/password-toggle.js"></script>
<script src="/js/auth.js"></script>
<%- include('partials/footer') %>
