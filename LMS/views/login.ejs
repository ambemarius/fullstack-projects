<%- include('partials/header', { title: 'Login' }) %>

<div class="lms-login-layout"><section class="lms-login-intro"><p class="lms-eyebrow">LYCEE BATOURI</p><h1>Welcome to your school workspace</h1><p>Sign in to the original application with your school account.</p><p>For registration, courses and staff accounts, you can also use the <a class="lms-login-school-link" href="https://localhost:2027/school">school dashboard</a>.</p></section>
<section class="card auth-card">
  <h2>Sign in</h2><p>Select your account type to continue.</p>
  <form id="loginForm">
    <label>Account type
      <select id="role">
        <option value="admin">Administrator</option>
        <option value="teacher">Teacher</option>
        <option value="student">Pupil</option>
      </select>
    </label>
    <label id="identLabel">Email
      <input id="identifier" required autocomplete="username" />
    </label>
    <label>Password
      <input type="password" id="password" required autocomplete="current-password" />
    </label>
    <button type="submit" class="btn">Sign in</button>
  </form>
  <p id="msg" class="msg" role="status" aria-live="polite"></p>
  <p class="lms-login-help">Forgotten your password? Contact your school administrator to arrange account recovery.</p>
</section></div>

<script src="/js/auth.js"></script>
<%- include('partials/footer') %>
