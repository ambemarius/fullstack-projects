<% const schoolLocal=typeof schoolAdministration!=='undefined'&&schoolAdministration; %>

<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Staff accounts · LYCEE BATOURI</title><link rel="stylesheet" href="/css/m1-preview.css"><script src="/js/canonical-staff-accounts.js" defer></script><%- include('partials/workspace-assets') %></head><body class="lms-ui lms-account-page" data-school-administration="<%= schoolLocal %>"><header><a href="/" class="brand">LYCEE BATOURI <span>Staff accounts</span></a></header><main><%- include('partials/workspace-wayfinding',{workspaceMode:'School',workspaceHome:'/school'}) %><p id="message" role="status" aria-live="polite"></p>

<h1>School accounts</h1><p id="school-context"></p><section class="panel" id="accept-panel"><h2>Set up or recover your staff account</h2><p>Your school super administrator supplies a private, single-use token. Choose your own password and keep it private.</p><form id="accept"><label>Token purpose<select id="purpose"><option value="activate">Create my staff account</option><option value="reset">Reset my staff password</option><% if(!schoolLocal){ %><option value="existing/accept">Join with my existing account</option><% } %></select></label><label>Invitation or recovery token<input id="token" type="password" required autocomplete="off" minlength="43" maxlength="43"></label><div id="password-fields"><label>New password<input id="password" type="password" required minlength="12" autocomplete="new-password"></label><label>Confirm new password<input id="confirm" type="password" required minlength="12" autocomplete="new-password"></label><p>At least 12 characters; maximum 72 UTF-8 bytes.</p></div><p id="existing-note" hidden>First <a href="/?next=staff-accounts">sign in to your existing staff account</a>, then paste the token here. Your password remains unchanged.</p><button>Continue</button></form></section>

<section id="operator" hidden><div class="panel"><h2>Add a school administrator</h2><p>Create a personal account for an administrator at your school. This does not grant platform or school super-administrator access.</p><form id="create-admin"><label>Full name<input id="admin-name" required maxlength="255"></label><label>Email<input id="admin-email" type="email" required maxlength="255"></label><button>Create administrator profile</button></form><p>Then issue an invitation below. The recipient chooses their password privately.</p></div><div class="panel"><h2>Your school’s staff accounts</h2><p><a href="/registration">Register pupils and teachers</a></p><p>Manage personal records and status in <a href="/auxiliary">Auxiliary staff</a>. Assign school access explicitly; job titles do not grant permissions.</p><div<%= schoolLocal?' hidden':'' %>><label>Account choice<select id="existing-account"><option value="">Create a new personal account</option></select></label><p>Existing account linking requires a separate review.</p></div><button id="refresh" type="button">Refresh</button><div class="table-wrap"><table><thead><tr><th>Staff member</th><th>Profile status</th><th>Access</th><th>Action</th></tr></thead><tbody id="profiles"></tbody></table></div></div>

<div class="panel" id="secret-note" hidden><h2>Give this token to the selected staff member</h2><p>Copy it now. It expires after 24 hours and is shown only once. Give the staff member this page address separately; no email is sent automatically.</p><output id="issued-token"></output></div>

<div class="panel"><h2>Recent staff tokens</h2><div class="table-wrap"><table><thead><tr><th>Profile</th><th>Purpose</th><th>Status</th><th>Expires</th><th>Action</th></tr></thead><tbody id="tokens"></tbody></table></div></div></section></main></body></html>

