        <!-- ===== STUDENT SUB-TAB ===== -->
        <div class="reg-subpanel active" id="sub-student">
          <div class="reg-header-bar" id="studentHeaderBar">Register New Student</div>
          <form id="studentForm" class="reg-student-form">
            <input type="hidden" id="studentEditId" value="" />
            <div class="reg-student-layout">
              <div class="reg-student-fields">
                <!-- Row: names -->
                <div class="reg-row-3">
                  <label>First Name <input id="sFirstName" required /></label>
                  <label>Middle Name <input id="sMiddleName" /></label>
                  <label>Last Name <input id="sLastName" required /></label>
                </div>
                <!-- Row: gender, dob, place of birth -->
                <div class="reg-row-3">
                  <label>Gender
                    <select id="sSex" required>
                      <option value="">--</option>
                      <option>Male</option>
                      <option>Female</option>
                    </select>
                  </label>
                  <label>Date of Birth <input id="sDob" type="date" /></label>
                  <label>Place of Birth <input id="sPlaceOfBirth" /></label>
                </div>
                <!-- Row: region, division -->
                <div class="reg-row-3">
                  <label>Region of Origin
                    <select id="sRegion"><option value="">-- select region --</option></select>
                  </label>
                  <label>Division
                    <select id="sDivision"><option value="">-- select region first --</option></select>
                  </label>
                  <label>Address <input id="sAddress" /></label>
                </div>
                <!-- Row: acc year, class, section -->
                <div class="reg-row-3">
                  <label>Academic Year <select id="sAcademicYear"><option value="">-- select --</option></select></label>
                  <label>Class <select id="sClass"><option value="">-- select --</option></select></label>
                  <label>Section
                    <select id="sSection">
                      <option>Anglophone</option>
                      <option>Francophone</option>
                    </select>
                  </label>
                </div>
                <!-- Row: matricule, password -->
                <div class="reg-row-3">
                  <label >Matricule <input id="sMatricule" placeholder="e.g. STU-OO1-OO1" required /></label>
                  <label>Password <input id="sPassword" type="password" required /></label>
                  <label>&nbsp;</label>
                </div>
                <!-- Parent / Guardian section -->
                <div class="reg-section-divider">Parent / Guardian Information</div>
                <div class="reg-row-3">
                  <label>Full Name <input id="sParentName" /></label>
                  <label>Telephone <input id="sParentPhone" type="tel" /></label>
                  <label>Telephone 2 <input id="sParentPhone2" type="tel" /></label>
                </div>
                <div class="reg-row-3">
                  <label>Medical Status <input id="sMedicalStatus" placeholder="Allergies, conditions..." /></label>
                  <label>&nbsp;</label>
                  <label>&nbsp;</label>
                </div>
              </div>

              <!-- Right: Fees section -->
              <div class="reg-student-fees">
                <div class="reg-fees-header">Fees</div>
                <div class="reg-fees-body" id="studentFinanceBody">
                  <p class="muted" id="studentFinanceNote">Fees are charged and paid in Finance. After saving, charge this student there, or charge the whole class from its fee schedule.</p>
                  <dl class="reg-finance-summary" id="studentFinanceSummary" hidden>
                    <dt>Charged</dt><dd id="sfCharged">—</dd>
                    <dt>Paid</dt><dd id="sfPaid">—</dd>
                    <dt>Outstanding</dt><dd id="sfBalance">—</dd>
                    <dt>Overdue</dt><dd id="sfOverdue">—</dd>
                  </dl>
                </div>
                <div class="reg-fees-total">
                  <a id="studentFinanceLink" href="/finance">Open Finance</a>
                </div>
              </div>
            </div>
            <div class="student-action-row">
              <button class="reg-btn reg-btn-blue" type="submit" id="studentSubmitBtn">Register Student</button>
            </div>
            <p id="studentFormMsg" class="msg" role="status" aria-live="polite"></p>
          </form>

          <!-- Search bar -->
          <div class="reg-action-bar">
            <div class="reg-search-group">
              <label class="reg-search-label" for="studentSearch">Global Search:</label>
              <input type="text" id="studentSearch" placeholder="Search by matricule, name or class..." class="reg-search-input" />
            </div>
            <div class="reg-action-btns">
              <button type="button" id="studentResetBtn" class="reg-btn reg-btn-gray"> RESET</button>
              <button type="button" id="studentEditBtn" class="reg-btn reg-btn-blue">EDIT</button>
              <button type="button" id="studentSaveBtn" class="reg-btn reg-btn-green">Save</button>
              <button type="button" id="studentDeleteBtn" class="reg-btn reg-btn-red">Delete</button>
            </div>
          </div>

          <!-- Student table -->
          <div class="reg-table-wrap">
            <div class="reg-table-scroll">
              <table class="reg-table">
                <thead>
                  <tr>
                    <th>Matricule</th>
                    <th>Name</th>
                    <th class="col-secondary">Sex</th>
                    <th class="col-secondary">Address</th>
                    <th class="col-secondary">Date of birth</th>
                    <th class="col-secondary">Region</th>
                    <th class="col-secondary">Division</th>
                    <th class="col-secondary">Place of birth</th>
                    <th>Class</th>
                    <th class="col-secondary">Year</th>
                    <th class="col-secondary">Parent / guardian</th>
                    <th class="col-secondary">Phone</th>
                    <th class="col-secondary">Medical</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody id="studentTableBody">
                  <tr><td colspan="14" class="reg-muted">Loading&hellip;</td></tr>
                </tbody>
              </table>
            </div>
            <div class="reg-table-footer">
              <span>Number of Students:</span>
              <span id="studentCount">0</span>
            </div>
          </div>
        </div>
