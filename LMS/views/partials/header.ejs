<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title + ' – KodoSchool' : 'KodoSchool' %></title>
  <link rel="stylesheet" href="/css/style.css?v=<%= locals.assetVersion || '' %>" />
<%- include('workspace-assets') %></head>
<body class="lms-ui">
  <a class="skip-link" href="#main-content">Skip to content</a>
  <header class="topbar">
    <a class="brand" href="/">KodoSchool<% if (!locals.hideSchoolName) { %> <span>Lycée Batouri</span><% } %></a>
    <nav class="nav" id="mainNav" aria-label="Main navigation">
      <!-- Admin navigates via the sidebar in the admin panel, so no admin tabs here -->
      <a href="/teacher-dashboard" data-roles="teacher">My dashboard</a>
      <a href="/timetable-teacher" data-roles="teacher">My timetable</a>
      <a href="/student-dashboard" data-roles="student">My dashboard</a>
      <a href="/timetable-student" data-roles="student">My timetable</a>
      <a href="/parent-dashboard" data-roles="parent">My children</a>
      <a href="/staff-dashboard" data-roles="auxiliary">My duties</a>
      <a href="/login" data-roles="guest">Sign in</a>
      <a href="#" id="navLogout" data-roles="admin,teacher,student,parent,auxiliary">Sign out</a>
    </nav>
  </header>
  <main class="container" id="main-content"><%- include('workspace-wayfinding',{workspaceMode:'Original application',workspaceHome:'/school'}) %>
