<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>LMS · School workspace</title><link rel="stylesheet" href="/css/m1-preview.css"><script src="/js/m1-preview.js" defer></script><%- include('partials/workspace-assets') %></head>
<body class="lms-ui lms-practice"><header><a class="brand" href="/">LMS <span>School workspace</span></a><div id="account-bar" hidden><label>School<select id="school-switch" aria-label="Active school"></select></label><button id="logout" class="quiet">Sign out</button></div></header>
<div class="sample-notice">Sample environment · Fictional records only · Changes are saved to the demonstration schools.</div>
<% if(typeof yearOfferings!=='undefined' && yearOfferings){ %><span id="year-offerings-enabled" hidden></span><% } %>
<main><%- include('partials/workspace-wayfinding',{workspaceMode:'Practice',workspaceHome:'https://localhost:2030/'}) %><div id="message" role="status" aria-live="polite"></div><section id="login-view"><div class="intro"><p class="eyebrow">YOUR SCHOOL, ORGANISED</p><h1>A clearer school day.</h1><p>Manage people, academic setup and subject memberships in one school workspace.</p><p>Choose a sample account to explore. School access follows the memberships of the selected account.</p></div><div class="panel"><h2>Explore a sample school</h2><div id="sample-accounts"></div><details><summary>Sign in with another test account</summary><form id="login-form"><label>School code<input name="schoolCode" required></label><label>Account type<select name="accountType"><option value="admin">Administrator</option><option value="teacher">Teacher</option><option value="student">Pupil</option></select></label><label>Email or matricule<input name="identifier" required autocomplete="username"></label><label>Password<input name="password" type="password" required autocomplete="current-password"></label><button>Sign in</button></form></details></div></section>
<section id="workspace" hidden><div class="heading"><div><p id="role-label" class="eyebrow"></p><h1 id="school-title"></h1><p id="year-label"></p></div><button id="refresh" class="quiet">Refresh</button></div><nav id="tabs" aria-label="Workspace sections"></nav><div id="content"></div></section></main><footer>LMS · School administration preview</footer></body></html>
