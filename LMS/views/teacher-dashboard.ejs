<%- include('partials/header', { title: 'Teacher Dashboard' }) %>
<% const wsBase = (typeof workspaceBaseUrl !== 'undefined' && workspaceBaseUrl) ? String(workspaceBaseUrl).replace(/\/+$/, '') : ''; %>
<% if (typeof canonicalAcademicLinksEnabled !== 'undefined' && canonicalAcademicLinksEnabled) { %><div class="alert alert-info" data-canonical-courses="true">Teaching assignments, rosters and raw marks are managed in the <% if (wsBase) { %><a href="<%= wsBase %>/courses">school course workspace</a><% } else { %>school course workspace<% } %>. Sign in there with your existing teacher account.</div><% } %>

<div class="card">
  <div class="page-head">
    <div>
      <h1>Teacher Dashboard</h1>
      <p id="welcome" class="welcome">Loading&hellip;</p>
    </div>
    <button id="logoutBtn" class="btn btn-secondary">Logout</button>
  </div>
  <div id="profile"></div>
</div>

<div class="card" id="attendanceCard">
  <h2>Take attendance</h2>
  <p class="muted">Your timetabled lessons for the day. Record a register up to 7 days back; the discipline master corrects older ones.</p>
  <div class="attendance-filters">
    <label>Date<input type="date" id="attDate"></label>
    <label>Term<select id="attTerm"><option>First</option><option>Second</option><option>Third</option></select></label>
  </div>
  <div id="attLessons" class="duty-list"><p class="muted">Loading&hellip;</p></div>
  <div id="attRegister"></div>
</div>

<div class="card">
  <div class="page-head">
    <div>
      <h2>Laboratory requests</h2>
      <p class="muted" style="margin:0">Request Physics, Chemistry, Biology, Geology or General lab equipment, reagents and consumables before your practical. Borrowed equipment must be returned by its return date.</p>
    </div>
    <a class="btn btn-secondary" href="/lab-requests">Open requests</a>
  </div>
</div>

<div class="card" id="dutyCard" hidden>
  <h2>My school duties</h2>
  <div id="dutyLinks" class="duty-list"></div>
</div>

<div class="card">
  <h3>My subjects</h3>
  <table>
    <thead><tr><th>Class</th><th>Subject</th><th>Code</th><th>Term</th></tr></thead>
    <tbody id="subjectRows"><tr><td colspan="4" class="muted">Loading&hellip;</td></tr></tbody>
  </table>
  <div id="subjectEmpty" class="empty-state" style="display:none">
    <div class="empty-state-icon"><%- include('partials/hub-icon', { icon: 'book' }) %></div>
    <h3>No subjects assigned</h3>
    <p>Subjects will appear here once the administrator assigns you to a class.</p>
  </div>
</div>

<div class="card">
  <h3>My students <span class="muted" id="studentCount"></span></h3>
  <table>
    <thead><tr><th>Name</th><th>Matricule</th><th>Section</th></tr></thead>
    <tbody id="studentRows"><tr><td colspan="3" class="muted">Loading&hellip;</td></tr></tbody>
  </table>
  <div id="studentEmpty" class="empty-state" style="display:none">
    <div class="empty-state-icon"><%- include('partials/hub-icon', { icon: 'people' }) %></div>
    <h3>No students yet</h3>
    <p>Students will appear here once they are enrolled in a class you teach.</p>
  </div>
</div>

<div class="card">
  <h3>Enter marks</h3>
  <form id="msForm" class="ms-picker">
    <label>Class and subject<select id="msSubject"><option value="">Choose a class and subject</option></select></label>
    <label>Term<select id="msTerm">
      <option value="">Choose a term</option>
      <option>First</option><option>Second</option><option>Third</option>
    </select></label>
    <button type="submit" id="msLoadBtn" class="btn">Open mark sheet</button>
  </form>
  <p id="msMsg" class="msg" role="status" aria-live="polite"></p>
  <div id="msSheet"><div class="ms-placeholder"><strong>Choose one of your classes and a term</strong>Both sequences open together, marked out of 20.</div></div>
</div>

<script src="/js/app.js"></script>
<script src="/js/toast.js"></script>
<script src="/js/mark-sheet.js"></script>
<script src="/js/teacher-dashboard.js"></script>
<script src="/js/duty-links.js"></script>
<script src="/js/attendance-register.js"></script>
<script src="/js/teacher-attendance.js"></script>
<%- include('partials/footer') %>
