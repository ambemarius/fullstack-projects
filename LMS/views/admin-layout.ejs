<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin Dashboard — LMS</title>
  <link rel="stylesheet" href="/css/style.css?v=<%= locals.assetVersion || '' %>" />
<%- include('partials/workspace-assets') %></head>
<% const wsBase = (typeof workspaceBaseUrl !== 'undefined' && workspaceBaseUrl) ? String(workspaceBaseUrl).replace(/\/+$/, '') : ''; %>
<body class="lms-ui  admin-body" data-workspace-base="<%= wsBase %>"<% if (typeof canonicalPersonnelEnabled !== 'undefined' && canonicalPersonnelEnabled) { %> data-canonical-personnel="true"<% } %><% if (typeof canonicalAcademicEnabled !== 'undefined' && canonicalAcademicEnabled) { %> data-canonical-academic="true"<% } %><% if (typeof canonicalAuxiliaryEnabled !== 'undefined' && canonicalAuxiliaryEnabled) { %> data-canonical-auxiliary="true"<% } %>>
  <aside class="sidebar" id="sidebar">
    <div class="sidebar-brand">
      <span class="sidebar-logo">KodoSchool
        
      </span>
      <span class="sidebar-sub">Lycée Batouri · Admin panel</span>
    </div>
    <nav class="sidebar-nav" aria-label="Admin sections">
      <div role="tablist" aria-orientation="vertical" aria-label="Admin panels">
        <button class="sidebar-tab" role="tab" id="tabbtn-home" data-tab="home" aria-controls="tab-home" aria-selected="true">
          <span class="tab-icon"><%- include('partials/hub-icon',{icon:'grid'}) %></span> Home
        </button>
        <button class="sidebar-tab" role="tab" id="tabbtn-registration" data-tab="registration" aria-controls="tab-registration" aria-selected="false" tabindex="-1">
          <span class="tab-icon"><%- include('partials/hub-icon',{icon:'people'}) %></span> Registration
        </button>
        <button class="sidebar-tab" role="tab" id="tabbtn-finance" data-tab="finance" aria-controls="tab-finance" aria-selected="false" tabindex="-1">
          <span class="tab-icon"><%- include('partials/hub-icon',{icon:'wallet'}) %></span> Finance
        </button>
        <button class="sidebar-tab" role="tab" id="tabbtn-evaluation" data-tab="evaluation" aria-controls="tab-evaluation" aria-selected="false" tabindex="-1">
          <span class="tab-icon"><%- include('partials/hub-icon',{icon:'book'}) %></span> Evaluation
        </button>
        <button class="sidebar-tab" role="tab" id="tabbtn-personnel" data-tab="personnel" aria-controls="tab-personnel" aria-selected="false" tabindex="-1">
          <span class="tab-icon"><%- include('partials/hub-icon',{icon:'shield'}) %></span> Personnel
        </button>
      </div>
      <p class="sidebar-section">School tools</p>
      <a class="sidebar-tab" href="/timetable">
        <span class="tab-icon"><%- include('partials/hub-icon',{icon:'calendar'}) %></span> Timetable
      </a>
      <a class="sidebar-tab" href="/promotion">
        <span class="tab-icon"><%- include('partials/hub-icon',{icon:'arrow'}) %></span> Promotion
      </a>
      <a class="sidebar-tab" href="/attendance">
        <span class="tab-icon"><%- include('partials/hub-icon',{icon:'people'}) %></span> Attendance
      </a>
      <a class="sidebar-tab" href="/finance">
        <span class="tab-icon"><%- include('partials/hub-icon',{icon:'wallet'}) %></span> Finance
      </a>
      <a class="sidebar-tab" href="/library">
        <span class="tab-icon"><%- include('partials/hub-icon',{icon:'book'}) %></span> Library
      </a>
      <a class="sidebar-tab" href="/laboratory">
        <span class="tab-icon"><%- include('partials/hub-icon',{icon:'flask'}) %></span> Laboratory
      </a>
    </nav>
    <div class="sidebar-footer">
      <button id="sidebarLogout" class="sidebar-logout">Sign out</button>
    </div>
  </aside>

  <div class="admin-main">
    <header class="admin-topbar">
      <div class="admin-topbar-left">
        <button id="menuToggle" class="menu-toggle">&#x2630;</button>
        <h2 id="panelTitle" class="panel-title">Home</h2>
      </div>
      <div class="admin-topbar-right">
        <span id="adminInfo" class="admin-info">Loading&hellip;</span>
        <button id="topLogout" class="btn btn-secondary btn-sm">Sign out</button>
      </div>
    </header>

    <div class="admin-content"><% if (typeof canonicalAcademicLinksEnabled !== 'undefined' && canonicalAcademicLinksEnabled) { %><p data-canonical-courses="true">Manage subject memberships, teaching assignments and raw marks in the <% if (wsBase) { %><a href="<%= wsBase %>/courses">school course workspace</a><% } else { %>school course workspace<% } %>.</p><% } %>
<%- include('partials/workspace-wayfinding',{workspaceMode:'Original application',workspaceHome:'/school'}) %>
      <% if (typeof canonicalPersonnelEnabled !== 'undefined' && canonicalPersonnelEnabled) { %>
      <p class="card">Student and teacher registration uses your school workspace.<% if (wsBase) { %> <a href="<%= wsBase %>/registration">Open registration</a>.<% } %> Other registration tools: <a href="#registration/subject">Subjects</a>, <a href="#registration/classes">Classes</a>, <a href="#registration/academic-years">Academic years</a>, <a href="#registration/auxiliary">Auxiliary staff</a>.</p>
      <% } %>
      <!-- ===== HOME TAB ===== -->
      <section class="tab-panel active" id="tab-home">
        <div class="welcome-row">
          <div class="card welcome-card">
            <h1 id="welcomeMsg">Welcome!</h1>
            <p class="welcome-text">School Management System — manage classes, teachers, students, and more from one place.</p>
          </div>
          
        </div>
        <div class="stats-row" id="statsRow">
          <div class="stat-card"><div class="stat-num" id="statTeachers">—</div><div class="stat-label">Teachers</div></div>
          <div class="stat-card"><div class="stat-num" id="statStudents">—</div><div class="stat-label">Students</div></div>
          <div class="stat-card"><div class="stat-num" id="statSubjects">—</div><div class="stat-label">Subjects</div></div>
          <div class="stat-card"><div class="stat-num" id="statClasses">—</div><div class="stat-label">Classes</div></div>
        </div>
      </section>

      <!-- ===== REGISTRATION TAB ===== -->
      <section class="tab-panel" id="tab-registration">
        <!-- Sub-tabs -->
        <div class="reg-subtabs" role="tablist" aria-label="Registration">
          <button class="reg-subtab active" role="tab" data-sub="student" aria-controls="sub-student" aria-selected="true">Students</button>
          <button class="reg-subtab" role="tab" data-sub="teacher" aria-controls="sub-teacher" aria-selected="false" tabindex="-1">Teachers</button>
          <button class="reg-subtab" role="tab" data-sub="subject" aria-controls="sub-subject" aria-selected="false" tabindex="-1">Subjects</button>
          <button class="reg-subtab" role="tab" data-sub="classes" aria-controls="sub-classes" aria-selected="false" tabindex="-1">Classes</button>
          <button class="reg-subtab" role="tab" data-sub="auxiliary" aria-controls="sub-auxiliary" aria-selected="false" tabindex="-1">Auxiliary staff</button>
          <button class="reg-subtab" role="tab" data-sub="academic-years" aria-controls="sub-academic-years" aria-selected="false" tabindex="-1">Academic years</button>
        </div>

        <!-- ===== STUDENT SUB-TAB ===== -->
        <div class="reg-subpanel active" id="sub-student">
          <div class="reg-header-bar" id="studentHeaderBar">Register New Student</div>
          <form id="studentForm" class="reg-student-form">
            <input type="hidden" id="studentEditId" value="" />
            <div class="reg-student-layout">
              <div class="reg-student-fields">
                <!-- Row: names -->
                <div class="reg-row-3">
                  <label>First Name <input id="sFirstName" required /></label>
                  <label>Middle Name <input id="sMiddleName" /></label>
                  <label>Last Name <input id="sLastName" required /></label>
                </div>
                <!-- Row: gender, dob, place of birth -->
                <div class="reg-row-3">
                  <label>Gender
                    <select id="sSex" required>
                      <option value="">--</option>
                      <option>Male</option>
                      <option>Female</option>
                    </select>
                  </label>
                  <label>Date of Birth <input id="sDob" type="date" /></label>
                  <label>Place of Birth <input id="sPlaceOfBirth" /></label>
                </div>
                <!-- Row: region, division -->
                <div class="reg-row-3">
                  <label>Region of Origin
                    <select id="sRegion"><option value="">-- select region --</option></select>
                  </label>
                  <label>Division
                    <select id="sDivision"><option value="">-- select region first --</option></select>
                  </label>
                  <label>Address <input id="sAddress" /></label>
                </div>
                <!-- Row: acc year, class, section -->
                <div class="reg-row-3">
                  <label>Academic Year <select id="sAcademicYear"><option value="">-- select --</option></select></label>
                  <label>Class <select id="sClass"><option value="">-- select --</option></select></label>
                  <label>Section
                    <select id="sSection">
                      <option>Anglophone</option>
                      <option>Francophone</option>
                    </select>
                  </label>
                </div>
                <!-- Row: matricule, password -->
                <div class="reg-row-3">
                  <label >Matricule <input id="sMatricule" placeholder="e.g. STU-OO1-OO1" required /></label>
                  <label>Password <input id="sPassword" type="password" required /></label>
                  <label>&nbsp;</label>
                </div>
                <!-- Parent / Guardian section -->
                <div class="reg-section-divider">Parent / Guardian Information</div>
                <div class="reg-row-3">
                  <label>Full Name <input id="sParentName" /></label>
                  <label>Telephone <input id="sParentPhone" type="tel" /></label>
                  <label>Telephone 2 <input id="sParentPhone2" type="tel" /></label>
                </div>
                <div class="reg-row-3">
                  <label>Medical Status <input id="sMedicalStatus" placeholder="Allergies, conditions..." /></label>
                  <label>&nbsp;</label>
                  <label>&nbsp;</label>
                </div>
              </div>

              <!-- Right: Fees section -->
              <div class="reg-student-fees">
                <div class="reg-fees-header">Fees</div>
                <div class="reg-fees-body" id="studentFinanceBody">
                  <p class="muted" id="studentFinanceNote">Fees are charged and paid in Finance. After saving, charge this student there, or charge the whole class from its fee schedule.</p>
                  <dl class="reg-finance-summary" id="studentFinanceSummary" hidden>
                    <dt>Charged</dt><dd id="sfCharged">—</dd>
                    <dt>Paid</dt><dd id="sfPaid">—</dd>
                    <dt>Outstanding</dt><dd id="sfBalance">—</dd>
                    <dt>Overdue</dt><dd id="sfOverdue">—</dd>
                  </dl>
                </div>
                <div class="reg-fees-total">
                  <a id="studentFinanceLink" href="/finance">Open Finance</a>
                </div>
              </div>
            </div>
            <div class="student-action-row">
              <button class="reg-btn reg-btn-blue" type="submit" id="studentSubmitBtn">Register Student</button>
            </div>
            <p id="studentFormMsg" class="msg" role="status" aria-live="polite"></p>
          </form>

          <!-- Search bar -->
          <div class="reg-action-bar">
            <div class="reg-search-group">
              <label class="reg-search-label" for="studentSearch">Global Search:</label>
              <input type="text" id="studentSearch" placeholder="Search by matricule, name or class..." class="reg-search-input" />
            </div>
            <div class="reg-action-btns">
              <button type="button" id="studentResetBtn" class="reg-btn reg-btn-gray"> RESET</button>
              <button type="button" id="studentEditBtn" class="reg-btn reg-btn-blue">EDIT</button>
              <button type="button" id="studentSaveBtn" class="reg-btn reg-btn-green">Save</button>
              <button type="button" id="studentDeleteBtn" class="reg-btn reg-btn-red">Delete</button>
            </div>
          </div>

          <!-- Student table -->
          <div class="reg-table-wrap">
            <div class="reg-table-scroll">
              <table class="reg-table">
                <thead>
                  <tr>
                    <th>Matricule</th>
                    <th>Name</th>
                    <th class="col-secondary">Sex</th>
                    <th class="col-secondary">Address</th>
                    <th class="col-secondary">Date of birth</th>
                    <th class="col-secondary">Region</th>
                    <th class="col-secondary">Division</th>
                    <th class="col-secondary">Place of birth</th>
                    <th>Class</th>
                    <th class="col-secondary">Year</th>
                    <th class="col-secondary">Parent / guardian</th>
                    <th class="col-secondary">Phone</th>
                    <th class="col-secondary">Medical</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody id="studentTableBody">
                  <tr><td colspan="14" class="reg-muted">Loading&hellip;</td></tr>
                </tbody>
              </table>
            </div>
            <div class="reg-table-footer">
              <span>Number of Students:</span>
              <span id="studentCount">0</span>
            </div>
          </div>
        </div>

        <!-- ===== TEACHER SUB-TAB ===== -->
        <div class="reg-subpanel" id="sub-teacher">
          <div class="reg-header-bar" id="teacherHeaderBar">Register New Teacher</div>
          <form id="teacherForm" class="teacher-split-form">
            <input type="hidden" id="teacherEditId" value="" />

            <div class="reg-form-split">
              <div>
                <div class="reg-section-divider" style="margin-top:0">Personal &amp; Contact Details</div>
                <div class="reg-row-3">
                  <label>First Name <input id="tFirstName" required /></label>
                  <label>Middle Name <input id="tMiddleName" /></label>
                  <label>Last Name <input id="tLastName" required /></label>
                </div>
                <div class="reg-row-3">
                  <label>Email <input id="tEmail" type="email" required /></label>
                  <label>Phone Number <input id="tPhone" type="tel" /></label>
                  <label>Gender
                    <select id="tGender">
                      <option value="">-- select --</option>
                      <option>Male</option>
                      <option>Female</option>
                    </select>
                  </label>
                </div>
                <div class="reg-row-3">
                  <label>Civil Status
                    <select id="tCivilStatus">
                      <option value="">-- select --</option>
                      <option>Single</option>
                      <option>Married</option>
                      <option>Divorced</option>
                      <option>Widowed</option>
                    </select>
                  </label>
                  <label>Number of Children <input id="tNoOfChildren" type="number" min="0" value="0" /></label>
                  <label>Address <input id="tAddress" /></label>
                </div>
              </div>

              <div>
                <div class="reg-section-divider" style="margin-top:0">Employment &amp; Identity Details</div>
                <div class="reg-row-3">
                  <label>Section
                    <select id="tSection" required>
                      <option value="">-- select --</option>
                      <option>Anglophone</option>
                      <option>Francophone</option>
                    </select>
                  </label>
                  <label>Employment Type
                    <select id="tEmpType" required>
                      <option value="">-- select --</option>
                      <option>Government</option>
                      <option>Part-time</option>
                    </select>
                  </label>
                  <label>Status
                    <select id="tStatus" required>
                      <option value="active">Active</option>
                      <option value="suspended">Suspended</option>
                      <option value="withdrawn">Withdrawn</option>
                    </select>
                  </label>
                </div>
                <div class="reg-row-3">
                  <label>ID Card Number <input id="tIdCard" /></label>
                  <label>Date of Issue <input id="tDateOfIssue" type="date" /></label>
                  <label>Matricule <input id="tMatriculeFile" placeholder="e.g. 100007f" /></label>
                </div>
                <div class="reg-row-2">
                  <label>Password <input id="tPassword" type="password" required /></label>
                  <label>Telephone (Alternate) <input id="tTelephone" type="tel" /></label>
                </div>
              </div>
            </div>

            <div class="reg-section-divider">Emergency / Secondary Contact</div>
            <div class="reg-row-2">
              <label>Secondary Contact Name <input id="tSecContactName" /></label>
              <label>Secondary Contact Phone <input id="tSecContactPhone" type="tel" maxlength="10" /></label>
            </div>

            <div class="teacher-action-row">
              <button class="reg-btn reg-btn-blue" type="submit" id="teacherSubmitBtn">Create Teacher</button>
            </div>
            <p id="teacherFormMsg" class="msg" role="status" aria-live="polite"></p>
          </form>

          <!-- Search bar for Teacher -->
          <div class="reg-action-bar">
            <div class="reg-search-group">
              <label class="reg-search-label" for="teacherSearch">Search Teacher:</label>
              <input type="text" id="teacherSearch" placeholder="Search by name or email..." class="reg-search-input" />
            </div>
            <div class="reg-action-btns">
              <button type="button" id="teacherResetBtn" class="reg-btn reg-btn-gray"> RESET</button>
              <button type="button" id="teacherEditBtn" class="reg-btn reg-btn-blue">EDIT</button>
              <button type="button" id="teacherSaveBtn" class="reg-btn reg-btn-green">Save</button>
              <button type="button" id="teacherDeleteBtn" class="reg-btn reg-btn-red">Delete</button>
            </div>
          </div>

          <!-- Teacher table -->
          <div class="reg-table-wrap">
            <div class="reg-table-scroll">
              <table class="reg-table">
                <thead>
                  <tr>
                    <th>Name</th>
                    <th class="col-secondary">Email</th>
                    <th class="col-secondary">Phone</th>
                    <th>Section</th>
                    <th class="col-secondary">Employment</th>
                    <th>Status</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody id="teacherTableBody">
                  <tr><td colspan="7" class="reg-muted">Loading&hellip;</td></tr>
                </tbody>
              </table>
            </div>
            <div class="reg-table-footer">
              <span>Number of Teachers:</span>
              <span id="teacherCount">0</span>
            </div>
          </div>
        </div>

        <!-- ===== SUBJECT SUB-TAB ===== -->
        <div class="reg-subpanel" id="sub-subject">
          <div class="reg-header-bar" id="subjectHeaderBar">Register New Subject</div>
          <form id="subjectForm" class="teacher-split-form">
            <input type="hidden" id="subjectEditId" value="" />
            
            <div class="reg-form-split">
              <div>
                <div class="reg-section-divider" style="margin-top:0">Subject Details</div>
                <div class="reg-row-3">
                  <label>Code <input id="subCode" required /></label>
                  <label>Name <input id="subName" required /></label>
                  <label>Coefficient <input id="subCoefficient" type="number" value="1" min="1" max="5" /></label>
                </div>
                <div class="reg-row-3">
                  <label>Hours per Week <input id="subHoursPerWeek" type="number" value="4" min="1" max="10" /></label>
                  <label>Categories
                    <select id="subCategories" required>
                      <option value="">-- Select Category --</option>
                      <option value="Science">Science</option>
                      <option value="Arts">Arts</option>
                      <option value="Compulsory">Compulsory</option>
                    </select>
                  </label>
                  <label>Has Lab
                    <select id="subHasLab">
                      <option value="">-- Select --</option>
                      <option value="true">Yes</option>
                      <option value="false">No</option>
                    </select>
                  </label>
                </div>
              </div>
              
              <div>
                <div class="reg-section-divider" style="margin-top:0">Assignment & Description</div>
                <div class="reg-row-3">
                  <label>Subject Master
                    <select id="subSubjectMaster">
                      <option value="">-- Select Teacher --</option>
                    </select>
                  </label>
                  <label>Class
                    <select id="subClassId">
                      <option value="">-- Select Class --</option>
                    </select>
                  </label>
                  <label>Description <input id="subDesc" /></label>
                </div>
              </div>
            </div>
            
            <div class="teacher-action-row">
              <button class="reg-btn reg-btn-blue" type="submit" id="subjectSubmitBtn">Create Subject</button>
            </div>
            <p id="subjectFormMsg" class="msg" role="status" aria-live="polite"></p>
          </form>

          <!-- Search bar for Subject -->
          <div class="reg-action-bar" style="margin-top: 24px;">
            <div class="reg-search-group">
              <label class="reg-search-label" for="subjectSearch">Search Subject:</label>
              <input type="text" id="subjectSearch" placeholder="Search by name or code..." class="reg-search-input" />
            </div>
          </div>

          <!-- Subject table -->
          <div class="reg-table-wrap">
            <div class="reg-table-scroll">
              <table class="reg-table">
                <thead>
                  <tr>
                    <th>Code</th>
                    <th>Name</th>
                    <th>Coefficient</th>
                    <th>Subject Master</th>
                    <th>Class</th>
                    <th>Hours/Week</th>
                    <th>Has Lab</th>
                    <th>Actions</th>
                  </tr>
                </thead>
                <tbody id="subjectTableBody">
                  <tr><td colspan="8" class="reg-muted">Loading&hellip;</td></tr>
                </tbody>
              </table>
            </div>
            <div class="reg-table-footer">
              <span>Number of Subjects:</span>
              <span id="subjectCount">0</span>
            </div>
          </div>
        </div>

        <!-- ===== CLASSES SUB-TAB ===== -->
        <div class="reg-subpanel" id="sub-classes">
          <div class="reg-header-bar">Add or Edit New Classes</div>
          <form id="classConfigForm" class="reg-form-grid">
            <div class="reg-form-fields">
              <div class="reg-field-row">
                <label class="reg-label" for="regSection">Class Code:**</label>
                <select id="regSection" class="reg-input">
                  <option value="">-- Choose Section --</option>
                  <option>Anglophone</option>
                  <option>Francophone</option>
                </select>
              </div>
              <div class="reg-field-row">
                <label class="reg-label" for="regClassName">Class Name:*</label>
                <select id="regClassName" class="reg-input">
                  <option value="">-- Choose Class --</option>
                </select>
              </div>
              <div class="reg-field-row">
                <label class="reg-label" for="regStream">Select Option:**</label>
                <select id="regStream" class="reg-input">
                  <option value="">-- Choose Option --</option>
                  <option value="Normal">Normal</option>
                  <option value="Bilingual">Bilingual</option>
                </select>
              </div>
              <div class="reg-field-row">
                <label class="reg-label" for="regMaster">Select Class Master:*</label>
                <select id="regMaster" class="reg-input">
                  <option value="">-- Choose Staff --</option>
                </select>
              </div>
              <input type="hidden" id="regClassId" value="" />
            </div>
            <div class="reg-fees-panel">
              <div class="reg-fees-header">Other Fees</div>
              <div class="reg-fees-body">
                <div class="reg-fee-row">
                  <label class="reg-fee-label" for="regFeeReg">Registration:*</label>
                  <input type="number" id="regFeeReg" value="0" class="reg-fee-input" />
                </div>
                <div class="reg-fee-row">
                  <label class="reg-fee-label" for="regFeeTuition">Tuition:*</label>
                  <input type="number" id="regFeeTuition" value="0" class="reg-fee-input" />
                </div>
                <div class="reg-fee-row">
                  <label class="reg-fee-label" for="regFeePta">PTA:*</label>
                  <input type="number" id="regFeePta" value="0" class="reg-fee-input" />
                </div>
                <div class="reg-fee-row">
                  <label class="reg-fee-label" for="regFeeCaution">Caution:</label>
                  <input type="number" id="regFeeCaution" value="0" class="reg-fee-input" />
                </div>
                <div class="reg-fee-row">
                  <label class="reg-fee-label" for="regFeePracticals">Practicals:</label>
                  <input type="number" id="regFeePracticals" value="0" class="reg-fee-input" />
                </div>
              </div>
              <div class="reg-fees-total">
                <span>Total Fees</span>
                <span id="regFeesTotal">0 XAF</span>
              </div>
            </div>
          </form>
          <div class="reg-action-bar">
            <div class="reg-search-group">
              <label class="reg-search-label" for="regSearchInput">Global Search:</label>
              <input type="text" id="regSearchInput" placeholder="Search..." class="reg-search-input" />
            </div>
            <div class="reg-action-btns">
              <button id="regResetBtn" class="reg-btn reg-btn-gray"> RESET</button>
              <button id="regEditBtn" class="reg-btn reg-btn-blue">EDIT</button>
              <button id="regSaveBtn" class="reg-btn reg-btn-green">Save</button>
              <button id="regDeleteBtn" class="reg-btn reg-btn-red">Delete</button>
            </div>
          </div>
          <div class="reg-table-wrap">
