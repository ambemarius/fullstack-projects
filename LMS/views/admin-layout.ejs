  <script src="/js/admin-teachers.js?v=<%= Date.now() %>"></script>
  <script src="/js/admin-registration.js?v=<%= Date.now() %>"></script>
  <script src="/js/mark-sheet.js?v=<%= Date.now() %>"></script>
  <script src="/js/admin-evaluation.js?v=<%= Date.now() %>"></script>
  <script src="/js/bulletin-settings.js?v=<%= Date.now() %>"></script>
  <script src="/js/admin-duties.js?v=<%= Date.now() %>"></script>
  <script src="/js/department-view.js?v=<%= Date.now() %>"></script>
  <script src="/js/admin-subject-results.js?v=<%= Date.now() %>"></script>
  <script src="/js/location-picker.js"></script>
</body>
</html>
