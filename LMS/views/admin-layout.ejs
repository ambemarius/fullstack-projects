            <button type="submit" class="btn">Grant duty</button>
            <fieldset class="duty-classes duty-dept" id="dutyDept" hidden>
              <legend>Department this head of department leads</legend>
              <p class="muted">They see the results of this subject in every class of the section, and prepare the department report.</p>
              <div class="duty-dept-row">
                <label>Subject<select id="dutyDeptSubject"><option value="">Choose a subject</option></select></label>
                <label>Section<select id="dutyDeptSection"><option value="Anglophone">Anglophone</option><option value="Francophone">Francophone</option><option value="">Both sections</option></select></label>
              </div>
            </fieldset>
            <fieldset class="duty-classes" id="dutyClasses" hidden>
              <legend>Classes this discipline master looks after</legend>
              <p class="muted">They see and justify the absences every teacher marks in these classes. Leave all unticked for the whole school.</p>
              <div class="duty-class-list" id="dutyClassList"></div>
            </fieldset>
          </form>
          <div class="table-wrap">
            <table>
              <thead><tr><th>Duty</th><th>Staff member</th><th>Email</th><th>Classes</th><th>Since</th><th><span class="sr-only">Actions</span></th></tr></thead>
              <tbody id="dutyRows"><tr><td colspan="6" class="muted">Loading&hellip;</td></tr></tbody>
            </table>
          </div>
          </div>
        </div>

        <!-- ===== AUXILIARY STAFF SIGN-IN SUB-TAB ===== -->
        <div class="reg-subpanel" id="sub-aux-signin">
          <div class="card">
            <div class="page-head">
              <div>
                <h3>Auxiliary staff sign-in</h3>
              </div>
            </div>
          <p class="muted">Auxiliary staff sign in with their email under "Non-teaching staff"; teachers with a duty keep signing in as Teacher. Their status must be Active. Passwords are 12 characters or more; share them in person.</p>
          <form id="auxPasswordForm" class="assign-form" autocomplete="off">
            <label>Auxiliary staff member
              <select id="auxPasswordStaff" required><option value="">Loading&hellip;</option></select>
            </label>
            <label>New password
              <input id="auxPasswordValue" type="password" minlength="12" maxlength="72" required autocomplete="new-password" />
            </label>
            <button type="submit" class="btn btn-secondary">Set password</button>
          </form>
          </div>
        </div>
      </section>
    </div>
  </div>

  <% if (typeof canonicalPersonnelEnabled !== 'undefined' && canonicalPersonnelEnabled) { %><script src="/js/legacy-personnel-handoff.js"></script><% } %>
