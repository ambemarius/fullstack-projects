<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Report Cards – <%= className %> – <%= term %> term <%= yearName %></title>
<style>
  @page { size: A4; margin: 8mm 9mm 7mm 9mm; }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: Arial, Helvetica, "Liberation Sans", "DejaVu Sans", sans-serif; font-size: 7.6pt; color: #000; background: #e9ecef; }
  .page { position: relative; background: #fff; width: 210mm; min-height: 297mm; margin: 0 auto 8mm; padding: 8mm 9mm 7mm; box-shadow: 0 1px 4px rgba(0,0,0,.2); page-break-after: always; break-after: page; }
  .page:last-child { page-break-after: auto; break-after: auto; }
  .mono { font-family: "Courier New", "Liberation Mono", "DejaVu Sans Mono", monospace; }
  .red { color: #d40000; }
  .c { text-align: center; }
  .r { text-align: right; }
  table { border-collapse: collapse; }

  /* screen-only toolbar */
  .toolbar { position: sticky; top: 0; z-index: 10; display: flex; flex-wrap: wrap; gap: 10px; align-items: center; justify-content: space-between;
             background: #1f3d2f; color: #fff; padding: 10px 16px; margin-bottom: 8mm; font-size: 13px; }
  .toolbar button, .toolbar a { font: inherit; padding: 8px 14px; border-radius: 6px; border: 1px solid #fff; background: #fff; color: #1f3d2f; cursor: pointer; text-decoration: none; }
  .toolbar a { background: transparent; color: #fff; }
  .empty { max-width: 600px; margin: 40px auto; background: #fff; padding: 24px; font-size: 14px; border-radius: 8px; }

  /* header */
  .gov { width: 100%; }
  .gov td { vertical-align: top; font-size: 7pt; line-height: 1.25; }
  .gov .logo { text-align: center; width: 18%; }
  .gov .logo img { height: 15mm; }
  .school-name { text-align: center; font-size: 12.5pt; font-weight: bold; margin: 1mm 0 0.6mm; }
  .doc-title { text-align: center; font-weight: bold; font-size: 7.5pt; line-height: 1.35; }
  .term { position: absolute; right: 9mm; top: 31mm; text-align: right; color: #555; font-size: 7.5pt; line-height: 1.3; }

  .info { width: 100%; margin-top: 2.5mm; }
  .info td { vertical-align: top; padding: 0.35mm 0; font-size: 7.4pt; }
  .info .big { font-size: 10.5pt; font-weight: bold; }
  .info .photo { width: 22mm; text-align: right; }
  .info .photo img, .info .photo .ph { width: 20mm; height: 22mm; object-fit: cover; border: 0.3pt solid #999; display: inline-block; }

  /* marks table */
  .wm-wrap { position: relative; margin-top: 1.5mm; }
  .watermark { position: absolute; left: 0; right: 0; top: 30mm; text-align: center; z-index: 0; font-size: 54pt; font-weight: bold;
               color: rgba(0,0,0,0.06); transform: rotate(-35deg); white-space: nowrap; }
  .marks { width: 100%; position: relative; z-index: 1; table-layout: fixed; }
  .marks th, .marks td { border: 0.6pt solid #000; padding: 0.5mm 0.8mm; height: 4.5mm; font-size: 7.2pt; vertical-align: middle; }
  .marks thead th { font-size: 6.9pt; text-align: left; vertical-align: bottom; line-height: 1.15; }
  .marks td.n { text-align: right; }
  .marks .grp { padding: 0; width: 5mm; vertical-align: middle; text-align: center; }
  .marks .grp .vt { display: inline-block; transform: rotate(-90deg); white-space: nowrap; font-weight: bold; font-size: 7.4pt; letter-spacing: 0.3pt; margin: 0 -60mm; }
  .marks tr.sub td { font-weight: bold; font-size: 7.8pt; }
  .marks td.grem { font-weight: bold; font-size: 9pt; vertical-align: middle; }
  .marks tr.grand td { font-weight: bold; font-size: 8.4pt; height: 5mm; }

  /* summary */
  .summary { width: 100%; margin-top: 1.4mm; }
  .summary td { padding: 0.5mm 0.6mm; font-size: 7.3pt; vertical-align: top; white-space: nowrap; }
  .summary .v { font-weight: bold; }
  .hist { border-collapse: collapse; margin-top: 0.8mm; }
  .hist td { border: 0.6pt solid #000; padding: 0.6mm 1.6mm; width: 18mm; font-size: 7.2pt; }
  .annual { margin-top: 1.5mm; font-weight: bold; font-size: 7.6pt; }

  .lower { width: 100%; margin-top: 2mm; }
  .lower > tbody > tr > td { vertical-align: top; }
  .disc-title { font-size: 7.6pt; margin-bottom: 0.5mm; }
  .disc { border-collapse: collapse; width: 74mm; }
  .disc td { border: 0.6pt solid #000; padding: 0.5mm 1mm; font-size: 6.9pt; }
  .disc td.cnt { width: 8mm; text-align: center; }
  .council { margin-top: 9mm; font-size: 7.6pt; }
  .sign { text-align: center; margin-top: 8mm; font-size: 7.4pt; }
  .sign img { height: 11mm; vertical-align: middle; margin-left: 4mm; }

  .footer { margin-top: 3mm; border-top: 0.6pt solid #000; padding-top: 1mm; width: 100%; }
  .footer td { font-size: 6pt; vertical-align: middle; }
  .footer .bc { text-align: right; }
  .footer .bc svg { height: 9mm; width: 45mm; }

  @media print {
    body { background: #fff; }
    .toolbar { display: none; }
    .page { width: auto; min-height: 0; margin: 0; padding: 0; box-shadow: none; }
    .term { right: 0; top: 23mm; }
  }
  @media screen and (max-width: 820px) {
    .page { width: 100%; min-height: 0; padding: 4mm; overflow-x: auto; }
    .marks { min-width: 180mm; }
  }
</style>
</head>
<body>
<div class="toolbar">
  <span><strong><%= className %></strong> · <%= term %> term · <%= yearName %> · <%= cards.length %> report card<%= cards.length === 1 ? '' : 's' %></span>
  <span>
    <a href="/admin-dashboard">Back</a>
    <button type="button" id="printBtn"<%= cards.length ? '' : ' disabled' %>>Print / Save as PDF</button>
  </span>
</div>
<% if (!cards.length) { %>
  <div class="empty">No students are enrolled in this class for the selected year, so there are no report cards to print.</div>
<% } %>
<% cards.forEach(card => { const s = card.school, st = card.student, t = card.totals; %>
<div class="page">
  <table class="gov"><tr>
    <td style="width:41%"><%= s.country_en %><br><%= s.motto_en %><br><%= s.ministry_en %></td>
    <td class="logo"><% if (s.logo) { %><img src="<%= s.logo %>" alt="School logo"><% } %></td>
    <td class="r" style="width:41%"><%= s.country_fr %><br><%= s.motto_fr %><br><%= s.ministry_fr %></td>
  </tr></table>

  <div class="school-name"><%= s.name_en %> | <%= s.name_fr %></div>
  <div class="doc-title">STUDENT REPORT CARD | BULLETIN DE NOTES<br>SECTION: <%= card.classroom.section %></div>
  <div class="term"><%= card.term.label_en %><br><%= card.term.label_fr %></div>

  <table class="info">
    <tr><td colspan="2" class="mono"><%= s.address_line %></td>
        <td class="photo" rowspan="6"><% if (st.photo) { %><img src="<%= st.photo %>" alt="Student photo"><% } else { %><span class="ph"></span><% } %></td></tr>
    <tr><td class="mono">SCHOOL YEAR | ANNEE SCOLAIRE &nbsp;&nbsp; <%= card.classroom.academic_year %></td>
        <td class="mono">Nr. d'Inscription: <%= st.matricule %></td></tr>
    <tr><td>Name of Student | Nom et Prenom: <span class="big"><%= String(st.full_name).toUpperCase() %></span></td>
        <td>Class | Classe: <b><%= card.classroom.name %></b></td></tr>
    <tr><td>Born on | Ne(e) le: <%= fmt.dmy(st.date_of_birth) %></td>
        <td>Enrolment | Effectif: <b><%= t.class_size %></b></td></tr>
    <tr><td colspan="2">Repeater | Redoublant(e): <%= st.is_repeater ? 1 : 0 %>
        &nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Parent's/Guardian's Address | Adresse du Parent ou tuteur: <%= st.parent_address %></td></tr>
    <tr><td colspan="2"></td></tr>
  </table>

  <div class="wm-wrap">
  <% if (s.watermark_text) { %><div class="watermark" aria-hidden="true"><%= s.watermark_text %></div><% } %>
  <table class="marks">
    <colgroup>
      <col style="width:5mm"><col style="width:33mm">
      <col style="width:11mm"><col style="width:11mm"><col style="width:11mm">
      <col style="width:8mm"><col style="width:13mm"><col style="width:8mm"><col style="width:15mm">
      <col style="width:37mm"><col>
    </colgroup>
    <thead><tr>
      <th></th>
      <th>SUBJECT NAME<br>DISCIPLINE</th>
      <th><%= card.seq_labels[0] %></th><th><%= card.seq_labels[1] %></th>
      <th>Avg<br>Moy. Tr.</th><th>Coef</th><th>Total<br>AvxC</th>
      <th>Pos.<br>Rang</th><th>SubjClsAvg<br>Moy. Cl.</th>
      <th>Teacher's Name<br>Nom du Prof.</th><th>Teacher's Remark<br>Appréciation des Prof.</th>
    </tr></thead>
    <tbody>
    <% card.groups.forEach(g => { const span = g.rows.length + g.padding + 2; %>
      <% g.rows.forEach((row, i) => { %>
      <tr>
        <% if (i === 0) { %><td class="grp" rowspan="<%= span %>"><span class="vt"><%= g.name %></span></td><% } %>
        <td><%= row.name %></td>
        <% row.seq.forEach((v, q) => { %><td class="n<%= row.seq_fail[q] ? ' red' : '' %>"><%= fmt.num(v) %></td><% }) %>
        <td class="n<%= row.fail ? ' red' : '' %>"><%= fmt.num(row.avg) %></td>
        <td class="c"><%= fmt.coef(row.coef) %></td>
        <td class="n<%= row.fail ? ' red' : '' %>"><%= fmt.num(row.total) %></td>
        <td class="c<%= row.fail ? ' red' : '' %>"><%= row.rank || '' %></td>
        <td class="n"><%= fmt.num(row.class_avg) %></td>
        <td><%= String(row.teacher || '').toUpperCase() %></td>
        <td class="<%= row.remark_fail ? 'red' : '' %>"><%= row.remark %></td>
      </tr>
      <% }) %>
      <% for (let p = 0; p < g.padding; p++) { %><tr><% for (let c = 0; c < 10; c++) { %><td></td><% } %></tr><% } %>
      <tr class="sub">
        <td>Sub Total</td>
        <% g.subtotal.seq.forEach(v => { %><td class="n"><%= fmt.num(v) %></td><% }) %>
        <td></td><td class="c"><%= fmt.coef(g.subtotal.coef) %></td><td class="n"><%= fmt.num(g.subtotal.total) %></td>
        <td></td><td></td><td></td>
        <td class="grem<%= g.remark_fail ? ' red' : '' %>" rowspan="2"><%= g.remark %></td>
      </tr>
      <tr class="sub">
        <td><%= g.average.label %></td>
        <% g.average.seq.forEach((v, q) => { %><td class="n<%= g.average.seq_fail[q] ? ' red' : '' %>"><%= fmt.num(v) %></td><% }) %>
        <td></td><td></td><td class="n<%= g.average.fail ? ' red' : '' %>"><%= fmt.num(g.average.total) %></td>
        <td></td><td></td><td></td>
      </tr>
    <% }) %>
    <% if (!card.groups.length) { %>
      <tr><td colspan="11" class="c">No marks recorded for this term yet.</td></tr>
    <% } %>
      <tr class="grand">
        <td colspan="2">&nbsp;TOTAL</td>
        <td></td><td></td><td></td>
        <td class="c"><%= fmt.coef(t.coef) %></td>
        <td class="n"><%= fmt.num(t.points) %></td>
        <td class="c"><%= t.rank || '' %></td>
        <td></td><td></td><td></td>
      </tr>
    </tbody>
  </table>
  </div>

  <table class="summary">
    <tr>
      <td>Terminal Av./Moy.: <span class="v<%= t.average_fail ? ' red' : '' %>"><%= fmt.num(t.average) %></span></td>
      <td>Status/Statut: <span class="v<%= card.status_fail ? ' red' : '' %>"><%= card.status %></span></td>
      <td>Position/Rang: <span class="v"><%= t.rank || '-' %> Out of/Sur <%= t.class_size %></span></td>
    </tr>
    <tr>
      <td>Class Av./Moy.: <span class="v"><%= fmt.num(t.class_average) %></span></td>
      <td>Annual Av./Moy.: <span class="v"><%= fmt.num(card.annual_average, '-') %></span></td>
      <td>Subj. Passed/Matières Réussies: <span class="v"><%= t.subjects_passed %> Out of/Sur <%= t.subjects_taken %></span></td>
    </tr>
    <tr>
      <td>Owing/Exigible: <span class="v"><%= fmt.money(card.owing) %> FCFA</span></td>
      <td>Reopening Date/Date de Réouverture: <span class="v"><%= fmt.dmy(card.term.reopening_date) %></span></td>
      <td>
        <table class="hist">
          <tr><% card.term_history.forEach(h => { %><td><%= h.label %></td><% }) %></tr>
          <tr><% card.term_history.forEach(h => { %><td><%= fmt.num(h.avg) %></td><% }) %></tr>
        </table>
        <div class="annual">Annual Av./Moy.: &nbsp;&nbsp; <%= fmt.num(card.annual_average, '-') %></div>
      </td>
    </tr>
  </table>

  <table class="lower"><tr>
    <td style="width:50%">
      <div class="disc-title">DISCIPLINARY RECORD/DOSSIER DISCIPLINAIRE</div>
      <table class="disc">
        <tr><td>Hours of absence/Heures d'absence</td><td class="cnt"><%= card.discipline.absences %></td></tr>
        <tr><td>Dis. Council Attendance/Participation Conseil Dis.</td><td class="cnt"><%= card.discipline.council_attendance %></td></tr>
        <tr><td>Warning/Avertissement</td><td class="cnt"><%= card.discipline.warnings %></td></tr>
        <tr><td>Suspension</td><td class="cnt"><%= card.discipline.suspensions %></td></tr>
      </table>
    </td>
    <td>
      <div class="council">Class Council/Conseil de Classe: <b><%= card.council_remark %></b></div>
    </td>
  </tr></table>

  <div class="sign">Principal Sign./Sign. Proviseur
    <% if (s.principal_signature) { %><img src="<%= s.principal_signature %>" alt="Principal's signature"><% } %></div>

  <table class="footer"><tr>
    <td><%= s.footer_text %></td>
    <td class="bc"><%- card.barcode %></td>
  </tr></table>
</div>
<% }) %>
<script src="/js/report-card-print.js"></script>
</body>
</html>
