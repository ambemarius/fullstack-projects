<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Student Dashboard – Lycée Batouri</title>
  <link rel="stylesheet" href="/css/style.css?v=<%= locals.assetVersion || '' %>" />
<%- include('partials/workspace-assets') %></head>
<% const wsBase = (typeof workspaceBaseUrl !== 'undefined' && workspaceBaseUrl) ? String(workspaceBaseUrl).replace(/\/+$/, '') : ''; %>
<% const icon = name => include('partials/hub-icon', { icon: name }); %>
<body class="lms-ui tp-body">
  <a class="skip-link" href="#tpContent">Skip to content</a>

  <!-- ================= SIDEBAR ================= -->
  <aside class="tp-sidebar" id="tpSidebar" aria-label="Student panel">
    <div class="tp-brand">
      <div class="tp-brand-name">LYCEE<br>BATOURI</div>
      <div class="tp-brand-panel">Student panel</div>
    </div>
    <nav class="tp-nav" aria-label="Student sections">
      <a class="tp-link" href="#overview" data-tab="overview"><%- icon('grid') %><span>Overview</span></a>
      <a class="tp-link" href="#results" data-tab="results"><%- icon('book') %><span>My results</span></a>
      <a class="tp-link" href="#attendance" data-tab="attendance"><%- icon('usercheck') %><span>My attendance</span></a>
      <a class="tp-link" href="#loans" data-tab="loans"><%- icon('library') %><span>My library loans</span></a>
      <a class="tp-link" href="#timetable" data-tab="timetable"><%- icon('calendar') %><span>My timetable</span></a>
    </nav>
    <div class="tp-side-foot">
      <button type="button" class="tp-signout" data-signout><svg class="hub-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg><span>Sign out</span></button>
    </div>
  </aside>
  <div class="tp-overlay" id="tpOverlay" hidden></div>

  <!-- ================= MAIN ================= -->
  <div class="tp-main">
    <header class="tp-topbar">
      <button type="button" class="tp-menu-btn" id="tpMenuBtn" aria-label="Open menu" aria-controls="tpSidebar" aria-expanded="false">
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
      </button>
      <h1 id="tpTitle">Overview</h1>
      <div class="tp-spacer"></div>
      <div class="tp-user">
        <span class="tp-user-name" id="tpUserName"></span>
        <span class="tp-avatar" id="tpAvatar" aria-hidden="true"></span>
        <button type="button" id="logoutBtn" class="tp-btn-outline">Sign out</button>
      </div>
    </header>

    <main class="tp-content" id="tpContent" tabindex="-1">
      <% if (typeof canonicalAcademicLinksEnabled !== 'undefined' && canonicalAcademicLinksEnabled) { %><div class="alert alert-info" data-canonical-courses="true">Your subject memberships are managed in the <% if (wsBase) { %><a href="<%= wsBase %>/courses">school course workspace</a><% } else { %>school course workspace<% } %>. Sign in there with your existing student account.</div><% } %>

      <!-- ===== Overview ===== -->
      <section class="tw-panel" id="sp-overview" aria-labelledby="tpTitle">
        <div class="tp-card tp-welcome">
          <h2 id="welcome">Loading&hellip;</h2>
          <p>Your results, attendance, library loans and timetable are in the menu on the left.</p>
        </div>
        <div class="tp-card tp-pad sp-block">
          <h2>My profile</h2>
          <div id="profile"></div>
        </div>
      </section>

      <!-- ===== My results ===== -->
      <section class="tw-panel tp-card tp-pad" id="sp-results" aria-labelledby="tpTitle" hidden>
        <div class="page-head">
          <h2>My results</h2>
          <label class="inline-label">Term
            <select id="resultsTerm">
              <option value="">All terms (Seq. 1–6)</option>
              <option value="First">First term (Seq. 1 &amp; 2)</option><option value="Second">Second term (Seq. 3 &amp; 4)</option><option value="Third">Third term (Seq. 5 &amp; 6)</option>
            </select>
          </label>
        </div>
        <p class="muted" id="resultsNote">Sequence marks out of 20 entered by your teachers. Ask your class master if a mark is missing.</p>
        <div class="table-wrap">
          <table id="resultsTable" class="sp-results">
            <thead><tr><th>Subject</th></tr></thead>
            <tbody><tr><td class="muted">Loading&hellip;</td></tr></tbody>
            <tfoot></tfoot>
          </table>
        </div>
        <div id="resultsEmpty" class="empty-state" style="display:none">
          <div class="empty-state-icon"><%- icon('book') %></div>
          <h3>No results published yet</h3>
          <p>Your marks appear here once your teachers publish them.</p>
        </div>
      </section>

      <!-- ===== My attendance ===== -->
      <section class="tw-panel tp-card tp-pad" id="sp-attendance" aria-labelledby="tpTitle" hidden>
        <div id="myAttendance">
          <div class="page-head">
            <h2>My attendance</h2>
            <label class="inline-label">Term
              <select id="attTerm"><option value="">Whole year</option><option>First</option><option>Second</option><option>Third</option></select>
            </label>
          </div>
          <div class="profile-grid" id="attTotals"><p class="muted">Loading&hellip;</p></div>
          <h3 style="margin-top:16px">Recent absences and lateness</h3>
          <div id="attRecent"></div>
        </div>
      </section>

      <!-- ===== My library loans ===== -->
      <section class="tw-panel tp-card tp-pad" id="sp-loans" aria-labelledby="tpTitle" hidden>
        <h2>My library loans</h2>
        <div id="myLoans"><p class="muted">Loading&hellip;</p></div>
      </section>

      <!-- ===== My timetable ===== -->
      <section class="tw-panel tp-card tp-pad" id="sp-timetable" aria-labelledby="tpTitle" hidden>
        <div class="page-head">
          <h2>My timetable</h2>
          <label class="inline-label">Term
            <select id="ttTerm">
              <option value="First">First</option><option value="Second">Second</option><option value="Third">Third</option>
            </select>
          </label>
        </div>
        <div class="table-wrap" id="ttGrid"><p class="muted">Loading&hellip;</p></div>
        <p><a class="btn btn-ghost" href="/timetable-student">Open full timetable</a></p>
      </section>
    </main>
  </div>

  <script src="/js/app.js"></script>
  <script src="/js/toast.js"></script>
  <script src="/js/student-panel.js"></script>
  <script src="/js/results-table.js"></script>
  <script src="/js/student-dashboard.js"></script>
  <script src="/js/attendance-summary.js"></script>
  <script src="/js/library-loans.js"></script>
</body>
</html>
