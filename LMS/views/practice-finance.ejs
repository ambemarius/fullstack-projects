<%- include('partials/finance-shell',{pageTitle:'Financial management',active:'charges'}) %>
<div class="page-heading"><div><h1>Financial management</h1><p>Track school fees, receive payments and follow up on balances.</p></div><div class="heading-actions"><a class="button secondary" href="/workspace/<%= area %>/collections">Collection reports and exports</a><% if(admin){ %><a class="button" href="#new-charge" data-open-panel="new-charge">+ New charge</a><% } %></div></div>
<div class="cards" aria-label="<%= search?'Matching':'All' %> active charges">
<section><h3>Total charged</h3><p><%= formatMoney(totals.charged) %></p><p>Active pupil charges</p></section><section><h3>Net collected</h3><p><%= formatMoney(totals.paid) %></p><p>After recorded reversals</p></section><section><h3>Outstanding balance</h3><p><%= formatMoney(totals.balance) %></p><p>Remaining on active charges</p></section></div>
<p class="scope-note"><%= search?'Matching search results':'All recorded charges' %> · XAF · Totals exclude cancelled charges and reversed payments. Fictional practice records.</p>
<div class="table-heading"><h2>Pupil charges</h2><span><%= charges.length %> <%= charges.length===1?'charge':'charges' %></span></div>
<form method="get" class="toolbar"><label>Search pupil, matricule, academic year or fee<input name="search" maxlength="120" value="<%= search %>" placeholder="Find a pupil or fee…"></label><button>Search</button><a href="/workspace/<%= area %>">Clear</a></form>
<div class="table-wrap"><table><thead><tr><th>Pupil</th><th>Year / fee</th><th class="numeric">Amount</th><th class="numeric">Collected</th><th class="numeric">Outstanding</th><th>Due / status</th><th>Action</th></tr></thead><tbody>
<% charges.forEach(c=>{ const status=c.cancelled?'Cancelled':BigInt(c.balance)===0n?'Paid':c.dueDate&&c.dueDate<today?'Overdue':'Open'; %><tr><td><span class="cell-primary"><%= c.pupil %></span><span class="cell-meta"><%= c.matricule %></span></td><td><span class="cell-primary"><%= c.description %></span><span class="cell-meta"><%= c.year %></span></td><td class="numeric"><%= formatMoney(c.amount) %></td><td class="numeric"><%= formatMoney(c.paid) %></td><td class="numeric"><%= c.cancelled?'—':formatMoney(c.balance) %></td><td><span class="status status-<%= status.toLowerCase() %>"><%= status %></span><span class="cell-meta"><%= c.dueDate||'No due date' %></span></td><td><a href="/workspace/<%= area %>?charge=<%= c.id %>">Open charge</a></td></tr><% }) %>
<% if(!charges.length){ %><tr><td colspan="7" class="empty"><strong>No charges found.</strong><%= search?'Try a different pupil name, matricule or fee description.':admin?'Create a pupil charge to start tracking fees and payments.':'Charges will appear here after an administrator creates them.' %></td></tr><% } %></tbody></table></div>
<% if(admin){ %><h2>Manage charges</h2><details id="new-charge"><summary>Create a pupil charge</summary><form method="post">
<%- include('partials/practice-operation') %><input type="hidden" name="action" value="charge">
<div class="fields"><label>Pupil<select name="pupil" required><option value="">Choose pupil</option><% pupils.forEach(p=>{ %><option value="<%= p.id %>"><%= p.label %></option><% }) %></select></label>
<label>Academic year<select name="year" required><option value="">Choose year</option><% years.forEach(y=>{ %><option value="<%= y.id %>"><%= y.label %></option><% }) %></select></label>
<label>Fee description<input name="description" maxlength="120" required placeholder="For example: Tuition, first instalment"></label>
<label>Amount (whole XAF)<input type="number" min="1" max="999999999999" step="1" name="amount" required></label><label>Due date (optional)<input type="date" name="due"></label></div><button>Create charge</button></form></details><% } %>
<% if(admin){ %><details><summary>Charge several pupils</summary><p>Choose up to 200 pupils and the academic year to charge. Review the exact charges before saving. No payments will be recorded.</p>
<form method="post" action="/workspace/<%= area %>/bulk/review"><input type="hidden" name="csrf" value="<%= csrf %>">
<div class="fields"><label>Academic year<select name="year" required><option value="">Choose year</option><% years.forEach(y=>{ %><option value="<%= y.id %>"><%= y.label %></option><% }) %></select></label>
<label>Fee / instalment description<input name="description" maxlength="120" required></label><label>Amount per pupil (whole XAF)<input type="number" name="amount" min="1" max="999999999999" step="1" required></label><label>Due date (optional)<input type="date" name="due"></label></div>
<fieldset><legend>Select pupils</legend><% pupils.forEach(p=>{ %><label><input type="checkbox" name="pupils" value="<%= p.id %>"> <%= p.label %></label><% }) %></fieldset><button>Review batch charges</button></form></details><% } %>
<%- include('partials/finance-end') %>
