<!doctype html><html lang="en-GB"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= hub.practice?'School feature menu':'School dashboard' %> · LMS</title><link rel="stylesheet" href="/css/school-hub.css"><script src="/js/school-hub.js" defer></script></head>
<body class="school-hub"><a class="hub-skip" href="#main">Skip to main content</a>
<aside class="hub-sidebar"><%- include('partials/hub-nav',{hub,mobile:false}) %></aside>
<div class="hub-shell"><header class="hub-topbar">
 <button class="hub-menu-button" id="hub-menu-open" aria-haspopup="dialog" aria-controls="hub-menu" hidden>☰ <span>Menu</span></button>
 <div class="hub-school"><strong><%= hub.schoolName %></strong><span><%= hub.yearLabel %></span></div>
 <span class="hub-status <%= hub.practice?'is-practice':'is-live' %>"><%= hub.practice?'Practice':'Live school' %></span>
 <details class="hub-account"><summary><span class="hub-avatar" aria-hidden="true"><%- include('partials/hub-icon',{icon:'people'}) %></span><span><%= hub.roleLabel %></span></summary>
 <div class="hub-account-panel"><strong><%= hub.roleLabel %></strong><p><%= hub.practice?'No live school account is connected here.':'Your access is verified by the school server.' %></p><a href="<%= hub.practice?((typeof workspaceBaseUrl!=='undefined'&&workspaceBaseUrl)||'')+'/school':'/' %>"><%= hub.practice?'Sign in to school records':'Manage session / sign out' %></a></div></details>
</header>
<details class="hub-mobile-fallback"><summary>School navigation</summary><%- include('partials/hub-nav',{hub,mobile:true}) %></details>
<main id="main" tabindex="-1"><section class="hub-intro" id="overview"><div><p class="hub-eyebrow">Your school, organised</p><h1><%= hub.practice?'School feature hub':'School dashboard' %></h1><p><%= hub.practice?'Choose a practice module, or sign in to manage your school records.':'Your school tools and records, together in one place.' %></p></div><% if(hub.practice){ %><a class="hub-button" href="<%= (typeof workspaceBaseUrl!=='undefined'&&workspaceBaseUrl)||'' %>/school">Open school workspace <%- include('partials/hub-icon',{icon:'arrow'}) %></a><% } %></section>
<% if(hub.modules.length){ %><section aria-labelledby="modules-title"><div class="hub-section-heading"><div><h2 id="modules-title">School operations</h2><p>Explore the workflows with fictional records.</p></div><span class="hub-tag">Practice modules</span></div>
<div class="hub-practice-notice"><%- include('partials/hub-icon',{icon:'shield'}) %><p><strong>Separate from live school records.</strong> Changes made here stay in the practice workspaces. Each workspace has its own sample account and academic context.</p></div>
<div class="hub-modules"><% for(const module of hub.modules){ %><article class="hub-module" id="<%= module.id %>"><div class="hub-card-heading"><span class="hub-module-icon"><%- include('partials/hub-icon',{icon:module.icon}) %></span><span class="hub-tag">Practice</span></div><h3><%= module.title %></h3><p><%= module.description %></p><div class="hub-module-actions">
<% if(hub.practice&&module.actions.length){ for(const [area,label] of module.actions){ %><form method="post" action="/open/<%= area %>"><button class="hub-module-action">Open as <%= label.toLowerCase() %><%- include('partials/hub-icon',{icon:'arrow'}) %></button></form><% } }else{ %><a class="hub-module-action" href="<%= module.href %>">Open <%= module.id==='attendance'?'attendance register':'practice workspace' %><%- include('partials/hub-icon',{icon:'arrow'}) %></a><% } %>
</div></article><% } %></div></section><% } %>
<section class="hub-records" aria-labelledby="records-title"><div class="hub-section-heading"><div><h2 id="records-title">School records</h2><p><%= hub.practice?'Use your school account to access pupils, staff and academic records.':'Tools available for your active school and role.' %></p></div><span class="hub-tag is-live">Live school</span></div>
<% if(hub.practice){ %><div class="hub-signin-card"><span class="hub-module-icon"><%- include('partials/hub-icon',{icon:'school'}) %></span><div><h3>Your school workspace</h3><p>People &amp; registration · Academics &amp; timetables · Administration &amp; reports</p><p>Your school account determines which tools you can open.</p></div><a class="hub-button hub-button-light" href="<%= (typeof workspaceBaseUrl!=='undefined'&&workspaceBaseUrl)||'' %>/school">Sign in to school records <%- include('partials/hub-icon',{icon:'arrow'}) %></a></div>
<% }else if(!hub.groups.length){ %><p class="hub-empty">No record tools are enabled for your role. Contact your school administrator if you need access.</p><% }else{ %><div class="hub-record-groups"><% for(const group of hub.groups){ %><section id="records-<%= group.icon %>"><h3><%- include('partials/hub-icon',{icon:group.icon}) %><%= group.title %></h3><% for(const [title,detail,href] of group.items){ %><a class="hub-record-link" href="<%= href %>"><span><strong><%= title %></strong><small><%= detail %></small></span><%- include('partials/hub-icon',{icon:'arrow'}) %></a><% } %></section><% } %></div><% } %></section>
<% if(hub.history){ %><section class="hub-history" id="academic-history"><span class="hub-module-icon"><%- include('partials/hub-icon',{icon:'book'}) %></span><div><h2>Academic history practice</h2><p>Explore dated enrolments, transfers and year-specific offerings with sample records.</p></div><a class="hub-text-link" href="<%= (typeof practiceEnrolmentUrl!=='undefined'&&practiceEnrolmentUrl)||'#academic-history' %>">Open enrolment practice <%- include('partials/hub-icon',{icon:'arrow'}) %></a></section><% } %>
<% if(hub.unavailableModules?.length){ %><section class="hub-history"><div><h2>Additional school modules</h2><p><%= hub.unavailableModules.join(', ') %> are not yet activated for your school. Your school administrator will confirm when they are ready.</p></div></section><% } %>
<footer class="hub-footer">LMS · School management <span><%= hub.practice?'Fictional practice records':'Access follows your active school membership' %></span></footer></main></div>
<dialog id="hub-menu" aria-labelledby="hub-menu-title"><div class="hub-dialog-heading"><h2 id="hub-menu-title">School navigation</h2><button id="hub-menu-close" aria-label="Close navigation">✕</button></div><%- include('partials/hub-nav',{hub,mobile:true}) %></dialog></body></html>
