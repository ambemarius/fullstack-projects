<%- include('partials/header', { title: 'End-of-year promotion' }) %>
<div class="page-head"><h1>End-of-year promotion</h1></div>

<div class="card">
  <p>Moves every active student in a class to the next level once the year's marks are final. Students below the pass average repeat the year; students in Upper Sixth / Terminale graduate. You will see the counts and confirm before anything changes.</p>

  <form id="promoteForm" class="assign-form">
    <label>Class
      <select id="promoteClass" required><option value="">Select a class</option></select>
    </label>
    <label>Academic year
      <select id="promoteYear" required><option value="">Select a year</option></select>
    </label>
    <button type="submit" class="btn" id="promoteBtn">Preview promotion</button>
  </form>
  <p id="promoteMsg" class="msg" role="status" aria-live="polite"></p>
</div>

<script src="/js/app.js"></script>
<script src="/js/toast.js"></script>
<script src="/js/promotion.js"></script>
<%- include('partials/footer') %>
