<!-- ================= EVERYONE SIGNS IN (animated) ================= -->
<style>
  .everyone { background: linear-gradient(180deg, #fff, var(--bg)); overflow: hidden; }
  .everyone .wrap { display: grid; grid-template-columns: .9fr 1.1fr; gap: 48px; align-items: center; }
  .who-chips { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }
  .who-chips button { display: inline-flex; align-items: center; gap: 8px; border: 1px solid var(--line); background: #fff;
                      font: inherit; font-weight: 700; font-size: 14px; color: var(--muted); padding: 10px 16px; border-radius: 999px;
                      cursor: pointer; transition: all .2s; }
  .who-chips button svg { width: 16px; height: 16px; }
  .who-chips button.on { background: var(--g-800); border-color: var(--g-800); color: #fff; box-shadow: 0 10px 20px -12px rgba(18,77,59,.8); }
  .who-caption { margin-top: 28px; padding: 18px 20px; background: #fff; border: 1px solid var(--line); border-radius: 14px;
                 display: flex; gap: 14px; align-items: center; min-height: 86px; }
  .who-caption .crest { width: 44px; height: 50px; flex: none; transition: color .6s; }
  .who-caption b { display: block; font-size: 16px; }
  .who-caption small { color: var(--muted); font-size: 14px; }
  .swatches { display: flex; gap: 6px; margin-top: 8px; }
