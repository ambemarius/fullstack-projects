<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Welcome - Government Bilingual Secondary School  Batouri</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: system-ui, -apple-system, sans-serif; line-height: 1.6; color: #1a1a2e; }
        .container { max-width: 1100px; margin: 0 auto; padding: 0 20px; }

        header { background: #1a1a2e; color: #fff; padding: 1rem 0; }
        header .container { display: flex; justify-content: space-between; align-items: center; }
        header h1 { font-size: 1.5rem; }
        header nav a { color: #e0e0e0; text-decoration: none; margin-left: 1.5rem; font-size: 0.9rem; }
        header nav a:hover { color: #fff; }

        .hero { padding: 80px 0; text-align: center; background: linear-gradient(135deg, #16213e 0%, #0f3460 100%); color: #fff; }
        .hero h2 { font-size: 2.5rem; margin-bottom: 1rem; }
        .hero p { font-size: 1.2rem; max-width: 600px; margin: 0 auto 2rem; color: #c0c0d0; }
        .hero .btn { display: inline-block; padding: 12px 32px; background: #e94560; color: #fff; text-decoration: none; border-radius: 6px; font-weight: 600; }

        .section { padding: 60px 0; }
        .section h3 { text-align: center; font-size: 1.8rem; margin-bottom: 2rem; }
        .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; }
        .card { background: #f8f9fa; padding: 2rem; border-radius: 8px; text-align: center; }
        .card h4 { margin-bottom: 0.5rem; color: #0f3460; }

        footer { background: #1a1a2e; color: #aaa; text-align: center; padding: 2rem 0; font-size: 0.9rem; }
    </style>
</head>
<body>
    <header>
        <div class="container">
            <h1>LMS Secondary School</h1>
            <nav>
                <a href="/">Home</a>
                <a href="#about">About</a>
                <a href="#contact">Contact</a>
                <a href="/login">Staff Login</a>
            </nav>
        </div>
    </header>

    <section class="hero">
        <div class="container">
            <h2>Shaping Tomorrow's Leaders Today</h2>
            <p>LMS Secondary School provides a nurturing environment where students excel academically, develop character, and prepare for a global future.</p>
            <a href="#about" class="btn">Learn More</a>
        </div>
    </section>

    <section class="section" id="about">
        <div class="container">
            <h3>About Our School</h3>
            <div class="grid">
                <div class="card">
                    <h4>Academic Excellence</h4>
                    <p>Comprehensive curriculum spanning sciences, arts, and technology with qualified teachers dedicated to student success.</p>
                </div>
                <div class="card">
                    <h4>Modern Facilities</h4>
                    <p>Well-equipped classrooms, science laboratories, computer labs, and a library to support effective learning.</p>
                </div>
                <div class="card">
                    <h4>Extracurricular</h4>
                    <p>Sports, clubs, and cultural activities that develop leadership, teamwork, and creativity in every student.</p>
                </div>
            </div>
        </div>
    </section>

    <section class="section" id="contact">
        <div class="container">
            <h3>Contact Us</h3>
            <div class="grid">
                <div class="card">
                    <h4>Address</h4>
                    <p>123 Education Avenue<br>City, Country</p>
                </div>
                <div class="card">
                    <h4>Phone</h4>
                    <p>+123 456 7890</p>
                </div>
                <div class="card">
                    <h4>Email</h4>
                    <p>info@lmsschool.edu</p>
                </div>
            </div>
        </div>
    </section>

    <footer>
        <div class="container">
            <p>&copy; <%= new Date().getFullYear() %> LMS Secondary School. All rights reserved.</p>
        </div>
    </footer>
</body>
</html>
