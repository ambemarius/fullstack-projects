<title>KodoSchool — The whole school, in one place</title>
<meta name="description" content="KodoSchool is a school management app for secondary schools: registers, marks, report cards, fees, library and laboratory, for administrators, teachers, parents and students.">
<link rel="stylesheet" href="/css/site-fonts.css">
<link rel="stylesheet" href="/css/site.css?v=<%= locals.assetVersion || '' %>">
