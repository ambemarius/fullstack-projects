<!-- ================= HERO ================= -->
<section class="hero">
  <div class="wrap">
    <div>
      <span class="pill"><i>New</i> Built for Cameroonian secondary schools</span>
      <h1>Your whole school, in <span class="hl">your pocket.<svg viewBox="0 0 300 14" preserveAspectRatio="none"><path d="M2 10 C 80 2, 200 2, 298 8" stroke="#f2cf7a" stroke-width="4" fill="none" stroke-linecap="round" opacity=".7"/></svg></span></h1>
      <p class="sub">Attendance and marks are recorded once. Report cards, class councils, fee balances and parent updates follow automatically, on any computer or phone.</p>
      <div class="ctas">
        <a href="/signup" class="btn btn-gold">Register your school <svg><use href="#i-arrow"/></svg></a>
        <a href="/login" class="btn btn-ghost">Sign in</a>
      </div>
      <div class="roles-line">
        <span><svg><use href="#i-grid"/></svg>Administration</span>
        <span><svg><use href="#i-pen"/></svg>Teachers</span>
        <span><svg><use href="#i-users"/></svg>Parents</span>
        <span><svg><use href="#i-book"/></svg>Students</span>
      </div>
    </div>

