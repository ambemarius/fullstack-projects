<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>LYCEE BATOURI · School workspace</title><link rel="stylesheet" href="/css/m1-preview.css"><script src="/js/canonical-school.js" defer></script><%- include('partials/workspace-assets') %></head>
<body class="lms-ui "><header><a class="brand" href="/">LMS <span>LYCEE BATOURI</span></a><button id="logout" hidden>Sign out</button></header>
<% if (typeof coursesEnabled !== 'undefined' && coursesEnabled) { %><nav id="course-nav" aria-label="Courses" hidden><a href="/courses">Subject memberships, teaching assignments and raw marks</a></nav><% } %>
<main><%- include('partials/workspace-wayfinding',{workspaceMode:'School',workspaceHome:'/school'}) %><div id="message" role="status" aria-live="polite"></div><section id="login-view"><div class="intro"><p class="eyebrow">LYCEE BATOURI</p><h1>Your school workspace</h1><p>Sign in with your existing school account and password.</p></div><div class="panel"><h2>School sign-in</h2><form id="login-form"><label>School code<input name="schoolCode" value="LYCEE_BATOURI" required readonly></label><label>Account type<select name="accountType"><option value="admin">Administrator</option><option value="teacher">Teacher</option><option value="student">Pupil</option><% if (typeof staffAccountsEnabled !== "undefined" && staffAccountsEnabled) { %><option value="staff">Auxiliary staff</option><% } %></select></label><label>Email or pupil matricule<input name="identifier" required autocomplete="username"></label><label>Password<input name="password" type="password" required autocomplete="current-password"></label><button id="submit">Sign in</button></form><% if (typeof staffAccountsEnabled !== "undefined" && staffAccountsEnabled) { %><p><a href="/staff-accounts">Staff account setup and password recovery</a></p><% } %></div></section>
<section id="workspace" hidden><p><a href="/school">Open school dashboard</a></p><h1>LYCEE BATOURI</h1><p id="identity-label"></p><% if (typeof personnelEnabled !== 'undefined' && personnelEnabled) { %><p>Manage school records in your workspace. Other school tools remain in the <a href="<%= (typeof workspaceBaseUrl!=='undefined'&&workspaceBaseUrl)||'' %>/admin-dashboard">original application</a>.</p><% } else { %><p>This workspace currently provides read-only access. Other school tools remain in the <a href="<%= (typeof workspaceBaseUrl!=='undefined'&&workspaceBaseUrl)||'' %>/login">original application</a>.</p><% } %><nav id="tabs" aria-label="School records" hidden><button data-kind="students">Pupils</button><button data-kind="teachers">Teachers</button><% if (typeof personnelEnabled !== 'undefined' && personnelEnabled) { %><a href="/registration">Register or edit pupils and teachers</a><% } %><% if (typeof academicEnabled !== 'undefined' && academicEnabled) { %><a href="/academic">Classes, subjects and academic years</a><% } %><% if (typeof auxiliaryEnabled !== "undefined" && auxiliaryEnabled) { %><a href="/auxiliary">Auxiliary staff</a><% } %><% if (typeof invitationsEnabled !== "undefined" && invitationsEnabled) { %><a href="/invitations">Administrator invitations</a><% } %></nav><% if (typeof invitationsEnabled !== "undefined" && invitationsEnabled) { %><a id="staff-invitations" href="/invitations" hidden>Accept an administrator invitation</a><% } %><div id="records"></div></section></main><footer>LYCEE BATOURI · School workspace</footer></body></html>
