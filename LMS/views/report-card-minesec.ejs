<%# MINESEC report card layouts (anglophone, francophone, technical): one A4 page per student.
    Figures come from utils/reportCardEngine.js; wording and council options from utils/reportCardTemplates.js. %>
<% const L0 = cards.length ? cards[0].tpl.L : { lang: 'en' }; %>
<!DOCTYPE html>
<html lang="<%= L0.lang === 'fr' ? 'fr' : 'en' %>">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Report Cards – <%= className %> – <%= term %> term <%= yearName %></title>
<style>
  @page { size: A4; margin: 8mm 9mm 7mm 9mm; }
  * { box-sizing: border-box; }
  body { margin: 0; font: 7.6pt Arial, Helvetica, "Liberation Sans", "DejaVu Sans", sans-serif; color: #000; background: #e9ecef; }
  .page { position: relative; background: #fff; width: 210mm; min-height: 297mm; margin: 0 auto 8mm; padding: 8mm 9mm 7mm; box-shadow: 0 1px 4px rgba(0,0,0,.2); page-break-after: always; break-after: page; }
  .page:last-child { page-break-after: auto; break-after: auto; }
  table { border-collapse: collapse; }
  .red { color: #d40000; } .c { text-align: center; } .n { text-align: right; }

  .toolbar { position: sticky; top: 0; z-index: 10; display: flex; flex-wrap: wrap; gap: 10px; align-items: center; justify-content: space-between;
             background: #1f3d2f; color: #fff; padding: 10px 16px; margin-bottom: 8mm; font-size: 13px; }
  .toolbar button, .toolbar a { font: inherit; padding: 8px 14px; border-radius: 6px; border: 1px solid #fff; background: #fff; color: #1f3d2f; cursor: pointer; text-decoration: none; }
  .toolbar a { background: transparent; color: #fff; }
  .empty { max-width: 600px; margin: 40px auto; background: #fff; padding: 24px; font-size: 14px; border-radius: 8px; }

  .gov { width: 100%; } .gov td { text-align: center; vertical-align: top; font-size: 7pt; line-height: 1.3; }
  .gov small { font-size: 5.6pt; letter-spacing: 1pt; } .gov img { height: 15mm; }
  .sname { text-align: center; font-size: 12.5pt; font-weight: bold; margin: 1.2mm 0 .4mm; }
  .saddr { text-align: center; font-size: 6.8pt; }
  .band { display: table; width: 100%; margin-top: 1.6mm; border-top: 1.2pt solid #000; border-bottom: 1.2pt solid #000; padding: 1mm 0; }
  .band > div { display: table-cell; vertical-align: middle; } .band .t { font-size: 10pt; font-weight: bold; }
  .band .term { text-align: right; font-weight: bold; font-size: 8pt; } .band .term span { display: block; font-weight: normal; font-size: 7pt; color: #444; }
  .info { width: 100%; margin-top: 2mm; } .info td { padding: .4mm 0; vertical-align: top; font-size: 7.4pt; }
  .info .big { font-size: 10pt; font-weight: bold; } .info .ph { width: 22mm; text-align: right; }
  .info .ph img, .info .ph span { width: 20mm; height: 22mm; object-fit: cover; border: .3pt solid #999; display: inline-block; }
  .wm-wrap { position: relative; margin-top: 1.5mm; }
  .watermark { position: absolute; left: 0; right: 0; top: 30mm; text-align: center; z-index: 0; font-size: 54pt; font-weight: bold;
               color: rgba(0,0,0,0.06); transform: rotate(-35deg); white-space: nowrap; }
  .marks { width: 100%; table-layout: fixed; position: relative; z-index: 1; }
  .marks th, .marks td { border: .6pt solid #000; padding: .5mm .8mm; height: 4.4mm; font-size: 7.1pt; vertical-align: middle; }
  .marks th { background: #eee; font-size: 6.6pt; text-align: center; } .marks th.l { text-align: left; }
  .marks tr.gh td { background: #dcdcdc; font-weight: bold; font-size: 6.9pt; height: 4mm; }
  .marks tr.sub td { background: #f4f4f4; font-weight: bold; font-size: 7.4pt; }
  .marks td.gr { text-align: center; font-weight: bold; font-size: 8pt; }
  .marks td.tch, .marks td.rem { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; font-size: 6.6pt; }
  .marks tr.tot td { background: #e6e6e6; font-weight: bold; font-size: 8.2pt; height: 5mm; }
  .res { width: 100%; margin-top: 1.6mm; border: .8pt solid #000; table-layout: fixed; }
  .res td { padding: 1mm 1.4mm; border-right: .6pt solid #000; vertical-align: top; font-size: 7.3pt; }
  .res b { display: block; font-size: 10pt; margin-top: .4mm; }
  .res b.st { font-size: 8.4pt; line-height: 1.15; }
  .low { width: 100%; margin-top: 1.6mm; table-layout: fixed; } .low > tbody > tr > td { vertical-align: top; } .low > tbody > tr > td + td { padding-left: 1.6mm; }
  .box { border: .8pt solid #000; } .box h4 { margin: 0; padding: .7mm 1.2mm; font-size: 6.8pt; background: #eee; border-bottom: .6pt solid #000; }
  .kv { width: 100%; } .kv td { padding: .55mm 1.2mm; font-size: 6.9pt; border-bottom: .4pt solid #bbb; } .kv td.v { text-align: right; font-weight: bold; width: 14mm; }
  .chk { padding: .6mm 1.2mm; font-size: 6.7pt; line-height: 1.4; } .chk .h { font-weight: bold; margin-top: .6mm; }
  .sq { display: inline-block; width: 2.6mm; height: 2.6mm; border: .6pt solid #000; margin-right: 1.2mm; vertical-align: -.4mm; text-align: center; line-height: 2.4mm; font-weight: bold; font-size: 6.5pt; }
  .hist { width: 100%; } .hist td { border-right: .4pt solid #bbb; border-top: .4pt solid #bbb; padding: .6mm; text-align: center; font-size: 6.9pt; }
  .hist tr:first-child td { border-top: 0; color: #444; }
  .rl { margin-top: 1.4mm; font-size: 7.4pt; } .rl b { font-size: 8.4pt; }
  .signs { width: 100%; margin-top: 2mm; table-layout: fixed; } .signs td { border: .6pt solid #000; height: 14mm; text-align: center; vertical-align: top; padding-top: .8mm; font-size: 7pt; }
  .signs img { display: block; margin: .6mm auto 0; height: 10mm; }
  .foot { width: 100%; margin-top: 1.6mm; } .foot td { font-size: 6pt; color: #444; vertical-align: middle; } .foot .bc { text-align: right; } .foot .bc svg { height: 8mm; width: 42mm; }

  @media print {
    body { background: #fff; }
    .toolbar { display: none; }
    .page { width: auto; min-height: 0; margin: 0; padding: 0; box-shadow: none; }
  }
  @media screen and (max-width: 820px) {
    .page { width: 100%; min-height: 0; padding: 4mm; overflow-x: auto; }
    .marks { min-width: 180mm; }
  }
</style>
</head>
<body>
<div class="toolbar">
  <span><strong><%= className %></strong> · <%= term %> term · <%= yearName %> · <%= cards.length %> report card<%= cards.length === 1 ? '' : 's' %></span>
  <span>
    <a href="/admin-dashboard">Back</a>
    <button type="button" id="printBtn"<%= cards.length ? '' : ' disabled' %>>Print / Save as PDF</button>
  </span>
</div>
<% if (!cards.length) { %>
  <div class="empty">No students are enrolled in this class for the selected year, so there are no report cards to print.</div>
<% } %>
<% cards.forEach(card => {
     const s = card.school, st = card.student, t = card.totals, d = card.discipline, T = card.tpl, L = T.L;
     const fr = L.lang === 'fr';
     const en = [s.country_en, s.motto_en, s.ministry_en], frh = [s.country_fr, s.motto_fr, s.ministry_fr];
     const left = fr ? frh : en, right = fr ? en : frh; %>
<div class="page">
  <table class="gov"><tr>
    <td style="width:41%"><%= left[0] %><br><small><%= left[1] %></small><br><%= left[2] %></td>
    <td><% if (s.logo) { %><img src="<%= s.logo %>" alt="School logo"><% } %></td>
    <td style="width:41%"><%= right[0] %><br><small><%= right[1] %></small><br><%= right[2] %></td>
  </tr></table>
  <div class="sname"><%= L.lang === 'bi' ? `${s.name_en} | ${s.name_fr}` : fr ? s.name_fr : s.name_en %></div>
  <div class="saddr"><%= s.address_line %></div>
  <div class="band"><div class="t"><%= L.title %></div><div class="term"><%= T.term_main %><% if (T.term_sub) { %><span><%= T.term_sub %></span><% } %></div></div>

  <table class="info">
    <tr><td><%= L.name %>: <span class="big"><%= String(st.full_name).toUpperCase() %></span></td><td><%= L.klass %>: <b><%= card.classroom.name %></b></td>
        <td class="ph" rowspan="5"><% if (st.photo) { %><img src="<%= st.photo %>" alt="Student photo"><% } else { %><span></span><% } %></td></tr>
    <tr><td><%= L.mat %>: <b><%= st.matricule %></b></td><td><%= L.year %>: <b><%= card.classroom.academic_year %></b></td></tr>
    <tr><td><%= L.born %>: <%= fmt.dmy(st.date_of_birth) %></td><td><%= L.enrol %>: <b><%= t.class_size %></b></td></tr>
    <tr><td><%= L.rep %>: <b><%= st.is_repeater ? L.yes : L.no %></b></td><td><%= L.section %>: <%= card.classroom.section %></td></tr>
    <tr><td colspan="2"><%= L.parent %>: <%= st.parent_address %></td></tr>
  </table>

  <div class="wm-wrap">
  <% if (s.watermark_text) { %><div class="watermark" aria-hidden="true"><%= s.watermark_text %></div><% } %>
  <table class="marks">
    <colgroup><col style="width:46mm"><col style="width:10mm"><col style="width:10mm"><col style="width:10.5mm"><col style="width:8mm">
      <col style="width:12mm"><col style="width:8mm"><col style="width:11mm"><col style="width:30mm"><col></colgroup>
    <tr><th class="l"><%= L.subject %></th><th><%= T.seq_labels[0] %></th><th><%= T.seq_labels[1] %></th><th><%= L.avg %></th><th><%= L.coef %></th>
      <th><%= L.total %></th><th><%= L.rank %></th><th><%= L.cavg %></th><th class="l"><%= L.teacher %></th><th class="l"><%= L.remark %></th></tr>
    <% card.groups.forEach((g, gi) => { const G = T.groups[gi]; %>
    <tr class="gh"><td colspan="10"><%= g.name %></td></tr>
    <% g.rows.forEach((r, ri) => { const R = T.rows[gi][ri]; %>
    <tr><td><%= r.name %></td>
      <% r.seq.forEach((m, q) => { %><td class="n<%= r.seq_fail[q] ? ' red' : '' %>"><%= fmt.num(m) %></td><% }) %>
      <td class="n<%= r.fail ? ' red' : '' %>"><b><%= fmt.num(r.avg) %></b></td><td class="c"><%= fmt.coef(r.coef) %></td>
      <td class="n<%= r.fail ? ' red' : '' %>"><%= fmt.num(r.total) %></td><td class="c<%= r.fail ? ' red' : '' %>"><%= r.rank || '' %></td>
      <td class="n"><%= fmt.num(r.class_avg) %></td><td class="tch"><%= String(r.teacher || '').toUpperCase() %></td><td class="rem<%= R.red ? ' red' : '' %>"><%= R.label %></td></tr>
    <% }) %>
    <tr class="sub"><td><%= L.subtotal %></td><% g.subtotal.seq.forEach(v => { %><td class="n"><%= fmt.num(v) %></td><% }) %><td></td>
      <td class="c"><%= fmt.coef(g.subtotal.coef) %></td><td class="n"><%= fmt.num(g.subtotal.total) %></td><td></td><td></td><td></td>
      <td class="gr<%= G.red ? ' red' : '' %>" rowspan="2"><%= G.remark %></td></tr>
    <tr class="sub"><td><%= G.avg_label %></td><% g.average.seq.forEach((v, q) => { %><td class="n<%= g.average.seq_fail[q] ? ' red' : '' %>"><%= fmt.num(v) %></td><% }) %>
      <td class="n<%= g.average.fail ? ' red' : '' %>"><%= fmt.num(g.average.total) %></td><td></td><td></td><td></td><td></td><td></td></tr>
    <% }) %>
    <% if (!card.groups.length) { %><tr><td colspan="10" class="c"><%= L.no_marks %></td></tr><% } %>
    <tr class="tot"><td>&nbsp;<%= L.total_row %></td><td></td><td></td><td class="n<%= t.average_fail ? ' red' : '' %>"><%= fmt.num(t.average) %></td>
      <td class="c"><%= fmt.coef(t.coef) %></td><td class="n"><%= fmt.num(t.points) %></td><td class="c"><%= t.rank || '' %></td><td></td><td></td><td></td></tr>
  </table>
  </div>

  <table class="res"><tr>
    <td><%= L.term_avg %><b class="<%= t.average_fail ? 'red' : '' %>"><%= fmt.num(t.average, '-') %> / 20</b></td>
    <td><%= L.position %><b><%= t.rank || '-' %> <%= L.out_of %> <%= t.class_size %></b></td>
    <td><%= L.class_avg %><b><%= fmt.num(t.class_average, '-') %></b></td>
    <td><%= L.annual %><b><%= fmt.num(card.annual_average, '-') %></b></td>
    <td><%= L.passed %><b><%= t.subjects_passed %> / <%= t.subjects_taken %></b></td>
    <td><%= L.status %><b class="st<%= T.status_red ? ' red' : '' %>"><%= T.status %></b></td>
  </tr></table>

  <table class="low"><tr>
    <td style="width:31%"><div class="box"><h4><%= L.disc %></h4><table class="kv">
      <tr><td><%= L.abs %></td><td class="v"><%= d.absences || 0 %></td></tr>
      <tr><td>&nbsp;&nbsp;<%= L.just %></td><td class="v"><%= d.justified || 0 %></td></tr>
      <tr><td>&nbsp;&nbsp;<%= L.unjust %></td><td class="v"><%= d.unjustified ?? d.absences ?? 0 %></td></tr>
      <tr><td><%= L.late %></td><td class="v"><%= d.lateness || 0 %></td></tr>
      <tr><td><%= L.warn %></td><td class="v"><%= d.warnings || 0 %></td></tr>
      <tr><td><%= L.susp %></td><td class="v"><%= d.suspensions || 0 %></td></tr>
      <tr><td><%= L.council %></td><td class="v"><%= d.council_attendance || 0 %></td></tr>
    </table></div></td>
    <td style="width:40%"><div class="box"><h4><%= L.decision %></h4><div class="chk">
      <div class="h"><%= L.work %></div><% T.work_opts.forEach(o => { %><div><span class="sq"><%= o.on ? '✓' : '' %></span><%= o.label %></div><% }) %>
      <div class="h"><%= L.conduct %></div><% T.cond_opts.forEach(o => { %><div><span class="sq"><%= o.on ? '✓' : '' %></span><%= o.label %></div><% }) %>
    </div></div></td>
    <td><div class="box"><h4><%= L.stats %></h4><table class="kv">
      <tr><td><%= L.class_avg %></td><td class="v"><%= fmt.num(t.class_average, '-') %></td></tr>
      <tr><td><%= L.high %></td><td class="v"><%= fmt.num(card.class_stats && card.class_stats.highest, '-') %></td></tr>
      <tr><td><%= L.low %></td><td class="v"><%= fmt.num(card.class_stats && card.class_stats.lowest, '-') %></td></tr>
      <tr><td><%= L.rate %></td><td class="v"><%= card.class_stats && card.class_stats.pass_rate !== null ? card.class_stats.pass_rate + '%' : '-' %></td></tr>
    </table></div>
    <div class="box" style="margin-top:1.4mm"><h4><%= L.hist %></h4><table class="hist">
      <tr><% T.history.forEach(h => { %><td><%= h.label %></td><% }) %><td><%= L.annual %></td></tr>
      <tr><% T.history.forEach(h => { %><td><b><%= fmt.num(h.avg, '–') %></b></td><% }) %><td><b><%= fmt.num(card.annual_average, '–') %></b></td></tr>
    </table></div></td>
  </tr></table>

  <div class="rl"><%= L.cremark %>: <b><%= T.council_remark %></b>
    <% if (card.term.reopening_date) { %> &nbsp;·&nbsp; <%= L.reopen %>: <b><%= fmt.dmy(card.term.reopening_date) %></b><% } %>
    <% if (card.owing > 0) { %> &nbsp;·&nbsp; <%= L.owing %>: <b><%= fmt.money(card.owing) %> FCFA</b><% } %></div>
  <table class="signs"><tr><td><%= L.master %></td><td><%= L.psign %></td>
    <td><%= L.principal %><% if (s.principal_signature) { %><img src="<%= s.principal_signature %>" alt="Principal's signature"><% } %></td></tr></table>
  <table class="foot"><tr><td><%= s.footer_text %></td><td class="bc"><%- card.barcode %></td></tr></table>
</div>
<% }) %>
<script src="/js/report-card-print.js"></script>
</body>
</html>
