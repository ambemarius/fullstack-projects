<%- include('partials/header', { title: 'Choose your password' }) %>
<%# First sign-in: the teacher replaces the password the administration gave them with one they will remember. %>
<div class="lms-login-layout cp-layout">
  <section class="card auth-card cp-card">
    <h2>Choose your own password</h2>
    <p class="muted">Your account was set up by the school administration. Before you start, replace the password you were given with one you will remember. Nobody else, not even the administration, will know it.</p>
    <form id="cpForm" novalidate>
      <label>Password you were given
        <input type="password" id="cpCurrent" required autocomplete="current-password" data-reveal />
      </label>
      <label>New password
        <input type="password" id="cpNext" required autocomplete="new-password" minlength="8" maxlength="72" data-reveal aria-describedby="cpHint" />
        <small id="cpHint" class="field-hint">At least 8 characters, with letters and numbers. Avoid your name or birthday.</small>
      </label>
      <label>Type the new password again
        <input type="password" id="cpNext2" required autocomplete="new-password" maxlength="72" data-reveal />
      </label>
      <button type="submit" class="btn" id="cpBtn" style="width:100%">Save my password</button>
    </form>
    <p id="cpMsg" class="msg" role="alert"></p>
  </section>
</div>
<script src="/js/password-toggle.js"></script>
<script src="/js/change-password.js"></script>
<%- include('partials/footer') %>
