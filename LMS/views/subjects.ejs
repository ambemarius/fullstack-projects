<%- include('partials/header', { title: 'Subjects' }) %>

<div class="page-head">
  <h1>Subjects</h1>
  <button id="logoutBtn" class="btn btn-secondary">Logout</button>
</div>

<div class="grid">
  <div class="card">
    <h3>Add subject</h3>
    <p class="muted">A new subject is automatically offered in all 21 classes.</p>
    <form id="createForm">
      <label>Name <input id="name" required /></label>
      <label>Code <input id="code" required /></label>
      <label>Description <input id="description" /></label>
      <button class="btn" type="submit">Create</button>
    </form>
    <p id="msg" class="msg"></p>
  </div>

  <div class="card">
    <h3>All subjects</h3>
    <table>
      <thead>
        <tr><th>ID</th><th>Name</th><th>Code</th><th>Description</th></tr>
      </thead>
      <tbody id="rows"><tr><td colspan="4" class="muted">Loading&hellip;</td></tr></tbody>
    </table>
  </div>
</div>

<script src="/js/app.js"></script>
<script src="/js/subjects.js"></script>
<%- include('partials/footer') %>
