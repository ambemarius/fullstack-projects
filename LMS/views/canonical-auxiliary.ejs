<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Auxiliary Staff — LYCEE BATOURI</title><link rel="stylesheet" href="/css/style.css"><link rel="stylesheet" href="/css/m1-original-registration.css"><script src="/js/canonical-auxiliary.js" defer></script><%- include('partials/workspace-assets') %></head>
<body class="lms-ui lms-static-sidebar admin-body"><aside class="sidebar"><div class="sidebar-brand"><span class="sidebar-logo">LYCEE BATOURI</span></div><nav class="sidebar-nav"><a class="sidebar-tab" href="/">Workspace</a><a class="sidebar-tab" href="/registration">Students / Teachers</a><a class="sidebar-tab" href="/academic">Academic setup</a><a class="sidebar-tab active" href="/auxiliary">Auxiliary staff</a></nav></aside><div class="admin-main"><header class="admin-topbar"><h1 class="panel-title">Auxiliary staff</h1><button id="logout" class="btn btn-secondary">Sign out</button></header><main class="admin-content"><%- include('partials/workspace-wayfinding',{workspaceMode:'School',workspaceHome:'/school'}) %><p id="message" role="status" aria-live="polite"></p><section id="workspace" hidden><p>Manage staff records here. Job titles and record status do not grant sign-in access; account permissions are managed separately.</p><div class="reg-header-bar" id="editor-title">Register Auxiliary Staff</div><form id="editor" class="teacher-split-form"><div class="reg-row-3"><label>First name<input name="firstName" required maxlength="100"></label><label>Middle name<input name="middleName" maxlength="100"></label><label>Last name<input name="lastName" required maxlength="100"></label><label>Email<input name="email" type="email" required maxlength="255"></label><label>Phone<input name="phone" maxlength="30"></label><label>Job title<input name="jobTitle" required maxlength="50"></label></div><div class="teacher-action-row"><button class="reg-btn reg-btn-blue" type="submit">Save</button><button id="reset" class="reg-btn reg-btn-gray" type="button">New record</button></div></form><label>Search<input id="search" type="search" placeholder="Name or email"></label><div class="reg-table-wrap"><table class="reg-table"><thead><tr><th>Name</th><th>Email</th><th>Job title</th><th>Status</th><th>Actions</th></tr></thead><tbody id="rows"></tbody></table></div><p id="count"></p><button id="previous" type="button">Previous</button><button id="next" type="button">Next</button></section></main></div></body></html>
