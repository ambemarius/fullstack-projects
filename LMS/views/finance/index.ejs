<%- include('shell',{pageTitle:'Financial management',active:'charges'}) %>
<div class="page-heading"><div><h1>Financial management</h1><p>Track school fees, receive payments and follow up on balances.</p></div><div class="heading-actions"><a class="button" href="<%= base %>/pay">Record payment</a><a class="button secondary" href="<%= base %>/outstanding">Outstanding balances</a><% if(canManage){ %><a class="button secondary" href="<%= base %>/charge">+ Charge a class</a><% } %></div></div>
<div class="cards" aria-label="<%= search?'Matching':'All' %> active charges">
<section><h3>Total charged</h3><p><%= formatMoney(totals.charged) %></p><p>Active student charges</p></section><section><h3>Net collected</h3><p><%= formatMoney(totals.paid) %></p><p>After recorded reversals</p></section><section><h3>Outstanding balance</h3><p><%= formatMoney(totals.balance) %></p><p>Remaining on active charges</p></section></div>
<p class="scope-note"><%= search?'Matching search results':'All recorded charges' %> · XAF · Totals exclude cancelled charges and reversed payments.</p>
<div class="table-heading"><h2>Student charges</h2><span><% if(totalCharges>perPage){ %>Showing <%= (page-1)*perPage+1 %>–<%= (page-1)*perPage+charges.length %> of <%= totalCharges.toLocaleString('en') %> charges<% }else{ %><%= totalCharges %> <%= totalCharges===1?'charge':'charges' %><% } %></span></div>
<form method="get" class="toolbar"><label>Search student, matricule, academic year or fee<input name="search" maxlength="120" value="<%= search %>" placeholder="Find a student or fee…"></label><button>Search</button><a href="<%= base %>">Clear</a></form>
<div class="table-wrap"><table><thead><tr><th>Student</th><th>Year / fee</th><th class="numeric">Amount</th><th class="numeric">Collected</th><th class="numeric">Outstanding</th><th>Due / status</th><th>Action</th></tr></thead><tbody>
<% charges.forEach(c=>{ const status=c.cancelled?'Cancelled':BigInt(c.balance)===0n?'Paid':c.dueDate&&c.dueDate<today?'Overdue':'Open'; %><tr><td><span class="cell-primary"><%= c.student %></span><span class="cell-meta"><%= c.matricule %></span></td><td><span class="cell-primary"><%= c.description %></span><span class="cell-meta"><%= c.year %></span></td><td class="numeric"><%= formatMoney(c.amount) %></td><td class="numeric"><%= formatMoney(c.paid) %></td><td class="numeric"><%= c.cancelled?'—':formatMoney(c.balance) %></td><td><span class="status status-<%= status.toLowerCase() %>"><%= status %></span><span class="cell-meta"><%= c.dueDate||'No due date' %></span></td><td><a href="<%= base %>?charge=<%= c.id %>">Open charge</a></td></tr><% }) %>
<% if(!charges.length){ %><tr><td colspan="7" class="empty"><strong>No charges found.</strong><%= search?'Try a different student name, matricule or fee description.':canManage?'Use Charge a class to charge a class from its fee schedule, or one student.':'Charges will appear here once they are created.' %></td></tr><% } %></tbody></table></div>
<% if(pages>1){ %><nav class="pager" aria-label="Charges pages"><% if(page>1){ %><a class="button secondary" href="?<%= pageQuery(page-1) %>" rel="prev">← Previous</a><% }else{ %><span class="button secondary is-disabled" aria-disabled="true">← Previous</span><% } %>
<span class="pager-status">Page <%= page %> of <%= pages %></span>
<% if(page<pages){ %><a class="button secondary" href="?<%= pageQuery(page+1) %>" rel="next">Next →</a><% }else{ %><span class="button secondary is-disabled" aria-disabled="true">Next →</span><% } %></nav><% } %>

<%- include('end') %>
