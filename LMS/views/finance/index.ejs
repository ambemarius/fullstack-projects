<%- include('shell',{pageTitle:'Financial management',active:'charges'}) %>
<div class="page-heading"><div><h1>Financial management</h1><p>Track school fees, receive payments and follow up on balances.</p></div><div class="heading-actions"><a class="button secondary" href="<%= base %>/collections">Collection reports and exports</a><% if(admin){ %><a class="button" href="#charge-class" data-open-panel="charge-class">+ Charge a class</a><% } %></div></div>
<div class="cards" aria-label="<%= search?'Matching':'All' %> active charges">
<section><h3>Total charged</h3><p><%= formatMoney(totals.charged) %></p><p>Active student charges</p></section><section><h3>Net collected</h3><p><%= formatMoney(totals.paid) %></p><p>After recorded reversals</p></section><section><h3>Outstanding balance</h3><p><%= formatMoney(totals.balance) %></p><p>Remaining on active charges</p></section></div>
<p class="scope-note"><%= search?'Matching search results':'All recorded charges' %> · XAF · Totals exclude cancelled charges and reversed payments.</p>
<div class="table-heading"><h2>Student charges</h2><span><%= charges.length %> <%= charges.length===1?'charge':'charges' %></span></div>
<form method="get" class="toolbar"><label>Search student, matricule, academic year or fee<input name="search" maxlength="120" value="<%= search %>" placeholder="Find a student or fee…"></label><button>Search</button><a href="<%= base %>">Clear</a></form>
<div class="table-wrap"><table><thead><tr><th>Student</th><th>Year / fee</th><th class="numeric">Amount</th><th class="numeric">Collected</th><th class="numeric">Outstanding</th><th>Due / status</th><th>Action</th></tr></thead><tbody>
<% charges.forEach(c=>{ const status=c.cancelled?'Cancelled':BigInt(c.balance)===0n?'Paid':c.dueDate&&c.dueDate<today?'Overdue':'Open'; %><tr><td><span class="cell-primary"><%= c.student %></span><span class="cell-meta"><%= c.matricule %></span></td><td><span class="cell-primary"><%= c.description %></span><span class="cell-meta"><%= c.year %></span></td><td class="numeric"><%= formatMoney(c.amount) %></td><td class="numeric"><%= formatMoney(c.paid) %></td><td class="numeric"><%= c.cancelled?'—':formatMoney(c.balance) %></td><td><span class="status status-<%= status.toLowerCase() %>"><%= status %></span><span class="cell-meta"><%= c.dueDate||'No due date' %></span></td><td><a href="<%= base %>?charge=<%= c.id %>">Open charge</a></td></tr><% }) %>
<% if(!charges.length){ %><tr><td colspan="7" class="empty"><strong>No charges found.</strong><%= search?'Try a different student name, matricule or fee description.':admin?'Charge a class from its fee schedule, or create a single student charge below.':'Charges will appear here after an administrator creates them.' %></td></tr><% } %></tbody></table></div>
<% if(admin){ %><h2>Manage charges</h2>
<details id="charge-class"><summary>Charge a class or several students</summary>
<p>Pick a class to select its students and use the fees set on that class (Registration → Classes). You can adjust the students, description and amount. Review the exact charges before anything is saved; no payments are recorded.</p>
<form method="post" action="<%= base %>/bulk/review" id="batchForm">
<div class="fields"><label>Class<select id="batchClass"><option value="">Any class</option><% classes.forEach(c=>{ %><option value="<%= c.id %>" data-fees="<%= JSON.stringify(c.fees) %>"><%= c.label %></option><% }) %></select></label>
<label>Fee from class schedule<select id="batchFee" disabled><option value="">Choose a class first</option></select></label>
<label>Academic year<select name="year" id="batchYear" required><option value="">Choose year</option><% years.forEach(y=>{ %><option value="<%= y.id %>" <%= y.isCurrent?'selected':'' %>><%= y.label %></option><% }) %></select></label>
<label>Fee / instalment description<input name="description" id="batchDescription" maxlength="120" required placeholder="For example: Tuition, first instalment"></label><label>Amount per student (whole XAF)<input type="number" name="amount" id="batchAmount" min="1" max="999999999999" step="1" required></label><label>Due date (optional)<input type="date" name="due"></label></div>
<fieldset id="batchStudents"><legend>Select students <span id="batchCount" class="cell-meta"></span></legend><% students.forEach(p=>{ %><label data-class="<%= p.classId||'' %>"><input type="checkbox" name="students" value="<%= p.id %>"> <%= p.label %></label><% }) %><% if(!students.length){ %><p>No active students registered.</p><% } %></fieldset><button>Review batch charges</button></form></details>
<details id="new-charge"><summary>Create a single student charge</summary><form method="post">
<%- include('operation') %><input type="hidden" name="action" value="charge">
<div class="fields"><label>Student<select name="student" required><option value="">Choose student</option><% students.forEach(p=>{ %><option value="<%= p.id %>"><%= p.label %></option><% }) %></select></label>
<label>Academic year<select name="year" required><option value="">Choose year</option><% years.forEach(y=>{ %><option value="<%= y.id %>" <%= y.isCurrent?'selected':'' %>><%= y.label %></option><% }) %></select></label>
<label>Fee description<input name="description" maxlength="120" required placeholder="For example: Tuition, first instalment"></label>
<label>Amount (whole XAF)<input type="number" min="1" max="999999999999" step="1" name="amount" required></label><label>Due date (optional)<input type="date" name="due"></label></div><button>Create charge</button></form></details>
<script src="/js/finance-batch.js" defer></script><% } %>
<%- include('end') %>
