<% const titles={library:'Library',laboratory:'Laboratory',requests:'Laboratory requests'}; %><!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title><%= pageTitle %> · <%= titles[area] %></title><link rel="stylesheet" href="/css/finance-workspace.css?v=<%= locals.assetVersion || '' %>"><script src="/js/finance-workspace.js?v=<%= locals.assetVersion || '' %>" defer></script><script src="/js/school-identity.js" defer></script></head><body class="finance-app" data-signin="/login">
<a class="skip-link" href="#finance-main">Skip to content</a>
<% const nav = () => { %><a class="finance-brand" href="<%= home %>"><span class="brand-mark">K</span><span>KodoSchool<small data-school-name>School tools</small></span></a>
<% if (locals.isAdmin) { %><%- include('../partials/admin-tool-nav', { active: area === 'requests' ? '' : area }) %><% } else { %><p class="nav-section"><%= titles[area].toUpperCase() %></p>
<nav aria-label="<%= titles[area] %>"><a href="<%= paths[area] %>" aria-current="page"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="<%= area==='library'?'M12 5v15M12 5C8 2 4 3 2 4v15c4-2 7-1 10 1 3-2 6-3 10-1V4c-2-1-6-2-10 1Z':'M9 3h6M10 3v7L4 19q-1 2 2 2h12q3 0 2-2l-6-9V3M7 15h10' %>"/></svg><%= titles[area] %></a></nav>
<% } %><div class="nav-bottom"><a href="<%= home %>"><span aria-hidden="true">←</span> Back to my dashboard</a></div><% } %>
<aside class="finance-sidebar"><% nav() %></aside>
<div class="finance-content"><header class="finance-topbar"><button type="button" id="finance-menu-open" class="secondary mobile-menu" hidden aria-haspopup="dialog">Menu</button><span class="workspace-path"><%= titles[area] %> <span aria-hidden="true">/</span> <strong><%= pageTitle %></strong></span><div class="workspace-identity"><span><%= actorName %></span><% if(roleLabel){ %><span class="role-label"><%= roleLabel %></span><% } %></div></header>
<details class="mobile-fallback"><summary>Navigation</summary><% nav() %></details>
<dialog id="finance-menu" aria-label="Navigation"><button type="button" id="finance-menu-close" class="secondary">Close menu</button><% nav() %></dialog>
<main id="finance-main" tabindex="-1">
