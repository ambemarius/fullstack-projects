<%- include('partials/header', { title: 'Teachers' }) %>

<div class="page-head">
  <h1>Teachers</h1>
  <button id="logoutBtn" class="btn btn-secondary">Logout</button>
</div>

<div class="grid">
  <div class="card" style="grid-column: span 2;">
    <h3 id="formTitle">Add teacher</h3>
    <form id="teacherForm">
      <input type="hidden" id="teacherId" />
      
      <!-- Section 1: Personal Information (left) and Employment & ID Details (right) side by side -->
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:24px;margin-bottom:20px;">
        
        <!-- Personal Information -->
        <fieldset style="border:1px solid #ddd;border-radius:8px;padding:16px;">
          <legend style="font-weight:600;color:#333;padding:0 8px;">Personal Information</legend>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
            <label>First name <input id="firstName" required /></label>
            <label>Middle name <input id="middleName" /></label>
            <label>Last name <input id="lastName" required /></label>
            <label>Gender
              <select id="gender">
                <option value="">-- select --</option>
                <option value="Male">Male</option>
                <option value="Female">Female</option>
              </select>
            </label>
            <label>Civil Status
              <select id="civilStatus">
                <option value="">-- select --</option>
                <option value="Single">Single</option>
                <option value="Married">Married</option>
                <option value="Divorced">Divorced</option>
                <option value="Widowed">Widowed</option>
              </select>
            </label>
            <label>No of Children <input id="noOfChildren" type="number" min="0" /></label>
            <label>ID Card No <input id="idCardNo" /></label>
            <label>Date of Issue <input id="dateOfIssue" type="date" /></label>
            <label>Email <input id="email" type="email" required /></label>
            <label>Phone <input id="phone" type="tel" /></label>
            <label>Matricule File <input id="matriculeFile" type="text" placeholder="File reference/path" /></label>
          </div>
        </fieldset>

        <!-- Employment & ID Details -->
        <fieldset style="border:1px solid #ddd;border-radius:8px;padding:16px;">
          <legend style="font-weight:600;color:#333;padding:0 8px;">Employment & ID Details</legend>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
            <label>Employment Type
              <select id="employmentType">
                <option value="Government">Government</option>
                <option value="Part-time">Part-time</option>
              </select>
            </label>
            <label>Section
              <select id="section">
                <option value="Anglophone">Anglophone</option>
                <option value="Francophone">Francophone</option>
              </select>
            </label>
            <label>Status
              <select id="status">
                <option value="active">Active</option>
                <option value="suspended">Suspended</option>
                <option value="withdrawn">Withdrawn</option>
              </select>
            </label>
            <label>Address <input id="address" style="width:100%;" /></label>
            <label>Telephone <input id="telephone" type="tel" /></label>
            <label>Password <input id="password" type="password" /></label>
          </div>
        </fieldset>
      </div>

      <!-- Section 2: Emergency/Secondary Contact (centered below) -->
      <fieldset style="border:1px solid #ddd;border-radius:8px;padding:16px;max-width:600px;margin:0 auto 20px;">
        <legend style="font-weight:600;color:#333;padding:0 8px;">Emergency / Secondary Contact</legend>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;">
          <label>Secondary Contact Name <input id="secondaryContactName" /></label>
          <label>Secondary Contact Phone <input id="secondaryContactPhone" type="tel" /></label>
        </div>
      </fieldset>

      <div style="margin-top:12px;display:flex;gap:8px;flex-wrap:wrap;justify-content:center">
        <button class="btn" type="submit" id="submitBtn">Create</button>
        <button class="btn btn-secondary" type="button" id="clearBtn" style="display:none">Clear</button>
        <button class="btn btn-danger" type="button" id="deleteBtn" style="display:none">Delete</button>
      </div>
    </form>
    <p id="msg" class="msg"></p>
  </div>

  <div class="card">
    <h3>All teachers</h3>
    <div style="margin-bottom:12px">
      <input type="text" id="searchInput" placeholder="Search by name or email..." style="width:100%;max-width:300px;padding:8px" />
    </div>
    <table>
      <thead>
        <tr><th>ID</th><th>Name</th><th>Email</th><th>Phone</th><th>Section</th><th>Type</th><th>Status</th><th>Actions</th></tr>
      </thead>
      <tbody id="rows"><tr><td colspan="8" class="muted">Loading&hellip;</td></tr></tbody>
    </table>
  </div>
</div>

<div class="card" style="margin-top:24px;">
  <h3>Assign a teacher to teach</h3>
  <p class="muted">Pick the teacher, the class, the subject offered in that class, and the term.</p>
  <form id="assignForm" class="assign-form">
    <select id="aTeacher" required><option value="">Teacher&hellip;</option></select>
    <select id="aClass" required><option value="">Class&hellip;</option></select>
    <select id="aSubject" required><option value="">Subject&hellip;</option></select>
    <select id="aTerm" required>
      <option value="">Term&hellip;</option>
      <option>First</option><option>Second</option><option>Third</option>
    </select>
    <button class="btn" type="submit">Assign</button>
  </form>
  <p id="assignMsg" class="msg"></p>
</div>

<script src="/js/app.js"></script>
<script src="/js/teachers.js"></script>
<%- include('partials/footer') %>
