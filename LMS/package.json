{
  "name": "lms",
  "version": "1.0.0",
  "description": "School Management System for Secondary school",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "nodemon server.js",
    "test": "node --require ./tests/setup.cjs --test --test-concurrency=1 tests/*.test.js",
    "test:sql": "node --require ./tests/setup.cjs --test --test-concurrency=1 tests/sql/*.test.js",
    "test:finance": "node --require ./tests/setup.cjs --test --test-concurrency=1 tests/sql/finance-workflows.test.js tests/sql/finance-batch.test.js tests/sql/inventory-workflows.test.js",
    "check:practice": "node scripts/checkSchoolPractice.js",
    "check:ui": "node scripts/checkUiRoutes.js",
    "setup": "node scripts/setupAcademic.js",
    "seed": "node scripts/seedAdmin.js",
    "seed:demo": "node scripts/seedDemo.js",
    "init": "node scripts/setupAcademic.js && node scripts/seedAdmin.js"
  },
  "keywords": [
    "lms",
    "Node server.js"
  ],
  "author": "Marius",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-async-handler": "^1.2.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "mssql": "^12.5.5",
    "multer": "^2.5.0",
    "nodemon": "^3.1.14"
  }
}
